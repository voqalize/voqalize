{
  "name": "@voqalize/client-react",
  "version": "0.2.0",
  "private": false,
  "description": "React SDK to embed a Voqalize voice agent — WebRTC transport, session bootstrap, and hooks/components.",
  "license": "Apache-2.0",
  "author": "Voqalize",
  "homepage": "https://voqalize.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voqalize/voqalize.git",
    "directory": "sdk/react"
  },
  "bugs": {
    "url": "https://github.com/voqalize/voqalize/issues"
  },
  "keywords": [
    "voice",
    "agents",
    "realtime",
    "webrtc",
    "speech",
    "react",
    "pipecat"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@pipecat-ai/client-js": ">=1.5.0 <2",
    "@pipecat-ai/client-react": ">=1.1.0 <2",
    "@pipecat-ai/small-webrtc-transport": ">=1.8.0 <2",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@pipecat-ai/client-js": "^1.13.0",
    "@pipecat-ai/client-react": "^1.8.1",
    "@pipecat-ai/small-webrtc-transport": "^1.10.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
