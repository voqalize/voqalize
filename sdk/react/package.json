{
  "name": "@voqalize/client-react",
  "version": "0.3.0",
  "private": false,
  "description": "Mint a Voqalize session for a pipecat client — the connection step, and nothing else.",
  "license": "Apache-2.0",
  "author": "Voqalize",
  "homepage": "https://voqalize.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voqalize/voqalize.git",
    "directory": "sdk/react"
  },
  "bugs": {
    "url": "https://github.com/voqalize/voqalize/issues"
  },
  "keywords": [
    "voice",
    "agents",
    "realtime",
    "webrtc",
    "speech",
    "pipecat"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
