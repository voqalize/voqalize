{
  "name": "@voqalize/web",
  "version": "0.1.0",
  "private": true,
  "description": "Voqalize in the browser: the widget, its parts, its configuration and headless controllers, over the session. Pre-release; not published.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voqalize/voqalize.git",
    "directory": "sdk/js/web"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./widgets": "./src/widgets.ts",
    "./launcher": "./src/launcher.ts",
    "./react": "./src/react.ts",
    "./internal": "./src/internal.ts",
    "./widget-config.schema.json": "./src/config/widget-config.schema.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./widgets": {
        "types": "./dist/widgets.d.ts",
        "default": "./dist/widgets.js"
      },
      "./launcher": {
        "types": "./dist/launcher.d.ts",
        "default": "./dist/launcher.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "./widget-config.schema.json": "./dist/config/widget-config.schema.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "size": "node scripts/size.mjs",
    "test:pages": "playwright test",
    "test:live": "playwright test --project live",
    "builder": "node builder/serve.mjs"
  },
  "dependencies": {
    "@pipecat-ai/client-js": "1.13.1",
    "@pipecat-ai/small-webrtc-transport": "1.10.8",
    "@voqalize/client-transport": "link:../../../../voqalize-client-transport",
    "lit": "3.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "happy-dom": "20.14.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "peerDependencies": {
    "@voqalize/avatar": "^0.7.1",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@voqalize/avatar": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
