# The qween agent's id and a publishable key for it whose allowed origins are
# https://www.qween.com. Neither is committed: this repo is public.
VOQALIZE_AGENT_ID=
VOQALIZE_PUBLISHABLE_KEY=
# The control plane the widget mints its session against: production. For a dev
# build, copy this to .env.dev with dev's agent, key and
# https://app.dev.voqalize.com/api/v1, and run `pnpm build:dev`.
VOQALIZE_API_BASE=https://app.voqalize.com/api/v1
