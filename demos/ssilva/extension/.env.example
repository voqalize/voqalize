# The ssilva agent's id and a publishable key for it whose allowed origins
# are https://www.ssilva.cl and https://ssilva.cl. Neither is committed: this
# repo is public. `pnpm build` reads .env; `pnpm build:prod` reads .env.prod.
VOQALIZE_AGENT_ID=
VOQALIZE_PUBLISHABLE_KEY=
# The control plane the widget mints its session against. Dev by default.
VOQALIZE_API_BASE=https://app.dev.voqalize.com/api/v1
# Whether the quote form's "Enviar" is stopped (1) or goes to Ssilva (0).
# Unset: stopped in the dev build, sent in the prod build.
SSILVA_BLOCK_SUBMIT=
