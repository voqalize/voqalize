# Wiring for this demo's frontend (Vite inlines VITE_* at build). Copy to `.env`
# and fill in per-environment values, or provision via the MCP server
# (`create_agent`, then `update_agent` to point it at your brain). The
# publishable key names its own workspace, so there is nothing here to select
# one with. With either left empty the app works fully by hand, without a call.
VITE_AGENT_ID=
VITE_PUBLISHABLE_KEY=
