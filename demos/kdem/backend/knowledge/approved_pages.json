  "excluded_patterns": [
    {"pattern": "^/sample-page/$", "why": "test or placeholder page"},
    {"pattern": "^/demo-home/$", "why": "test or placeholder page"},
    {"pattern": "^/demo-page/$", "why": "test or placeholder page"},
    {"pattern": "^/home-1/$", "why": "test or placeholder page"},
    {"pattern": "^/home-2/$", "why": "test or placeholder page"},
    {"pattern": "^/coming-soon/$", "why": "test or placeholder page"},
    {"pattern": "^/design-old/$", "why": "test or placeholder page"},
    {"pattern": "^/design-approval/$", "why": "form-only page"},
    {"pattern": "-old/$", "why": "superseded copy of a page; an approved one is listed as an alias of its canonical"},
    {"pattern": "-registration/$", "why": "form-only page"},
    {"pattern": "^/apply-now/$", "why": "form-only page"},
    {"pattern": "^/(category|tag|agenda_category|agenda-speaker|mec-category)/", "why": "taxonomy archive"},
    {"pattern": "^/\\d{4}/\\d{2}/(\\d{2}/)?", "why": "date archive"},
    {"pattern": "(^|/)feed/$", "why": "feed"},
    {"pattern": "^/wp-(json|admin|includes)/", "why": "WordPress internals"},
    {"pattern": "^/wp-content/(?!uploads/.*\\.(?i:pdf)$)", "why": "WordPress internals, and uploads other than PDFs"},
    {"pattern": "^/wp-[^/]*\\.(php|xml|xsl)$", "why": "WordPress internals and sitemaps"}
  ],
  "held_patterns": [
    {"pattern": "(agenda|speaker)", "why": "agenda and speaker lists are about individuals; a person decides"},
    {"pattern": "^/kaipidi/$", "why": "older programme page; a person checks it before it goes live"},
    {"pattern": "^/karnataka-mitra/$", "why": "older programme page; a person checks it before it goes live"},
    {"pattern": "^/fellowship-programme/$", "why": "older programme page; a person checks it before it goes live"},
    {"pattern": "^/cohort-2/$", "why": "the page draws its content with a script, so it has no text to answer from; a person checks it"}
  ]
