{
  "about": "The pages of karnatakadigital.in that Aria may answer from, one canonical URL per topic. KDEM reviews this list. Paths are matched after canonicalisation: https, no www, no query or fragment, trailing slash. `knowledge.py` reads this file at import and refuses to start on a malformed entry.",
  "site": "https://karnatakadigital.in",
  "sitemap": "https://karnatakadigital.in/wp-sitemap.xml",
  "contact_url": "https://karnatakadigital.in/contact-us/",
  "sections": {
    "news": {
      "approved": true,
      "auto_add": true,
      "post_types": ["news"],
      "sitemap_source": "wp-sitemap-posts-news-*.xml (URLs /news/<slug>/)",
      "notes": "Industry-news digest: a headline, a date and a link to the outside publisher. Indexed as title, date and URL. Not KDEM's own statements."
    },
    "events": {
      "approved": true,
      "auto_add": true,
      "post_types": ["mec-events"],
      "sitemap_source": "wp-sitemap-posts-mec-events-1.xml (URLs /events/<slug>/)",
      "notes": "One page per event, with its date, time and place. The date is kept so past and upcoming events can be told apart."
    },
    "event-landing-pages": {
      "approved": true,
      "auto_add": true,
      "post_types": ["page"],
      "sitemap_source": "wp-sitemap-posts-page-1.xml (flat slugs)",
      "notes": "Flagship event pages. A new one is added when the Events hub links to it. Agenda and speaker sub-pages are held for review."
    },
    "focus-areas-programmes": {
      "approved": true,
      "auto_add": true,
      "post_types": ["page"],
      "read_pdfs": true,
      "sitemap_source": "wp-sitemap-posts-page-1.xml (flat slugs)",
      "notes": "Focus areas and programmes. A new page is added when an approved programme page links to it. The PDFs the approved pages here link to (their Policies & Schemes documents) are read."
    },
    "policies-resources": {
      "approved": true,
      "auto_add": true,
      "post_types": ["page"],
      "read_pdfs": true,
      "sitemap_source": "wp-sitemap-posts-page-1.xml",
      "notes": "Policies, guidelines, reports and the newsletter. Most substance is in PDFs: the PDFs the approved pages here link to are read, page by page, and Aria links to the PDF itself. Scanned PDFs (images only) are not read."
    },
    "core-pages": {
      "approved": true,
      "auto_add": false,
      "post_types": ["page"],
      "sitemap_source": "wp-sitemap-posts-page-1.xml",
      "notes": "A fixed set: home, about, contact, careers, tenders, the events index and the news index. Re-read when their lastmod changes."
    },
    "blog-posts": {
      "approved": false,
      "auto_add": false,
      "post_types": ["post"],
      "sitemap_source": "wp-sitemap-posts-post-1.xml",
      "notes": "Generic WordPress posts. Every one is held for review; a person may promote one by adding it to `pages` below."
    },
    "agenda-and-speakers": {
      "approved": false,
      "auto_add": false,
      "post_types": ["agenda", "our-2025-speakers", "our-speakers", "event_speakers"],
      "sitemap_source": "wp-sitemap-posts-agenda-1.xml, wp-sitemap-posts-our-2025-speakers-1.xml, wp-sitemap-posts-our-speakers-1.xml, wp-sitemap-posts-event_speakers-1.xml",
      "notes": "Session slots and speaker profiles for past events. About individuals, not KDEM programmes. Held for review."
    },
    "registration-forms": {
      "approved": false,
      "auto_add": false,
      "post_types": ["page"],
      "sitemap_source": "wp-sitemap-posts-page-1.xml",
      "notes": "Form-only pages. Never indexed (see excluded_patterns). Aria does not collect personal data."
    },
    "misc-legacy-pages": {
      "approved": false,
      "auto_add": false,
      "post_types": ["page"],
      "sitemap_source": "wp-sitemap-posts-page-1.xml",
      "notes": "Pages no hub links to, such as the image gallery and the blog index. Held for review."
    },
    "taxonomies": {
      "approved": false,
      "auto_add": false,
      "post_types": [],
      "sitemap_source": "wp-sitemap-taxonomies-*.xml",
      "notes": "Category and tag archive listings. They carry no lastmod and are never read."
    },
    "test-placeholder": {
      "approved": false,
      "auto_add": false,
      "post_types": ["page"],
      "sitemap_source": "wp-sitemap-posts-page-1.xml",
      "notes": "Test and placeholder pages. Permanently excluded (see excluded_patterns)."
    }
  },
