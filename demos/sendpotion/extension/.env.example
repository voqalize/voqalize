# The sendpotion agent's id and a publishable key for it whose allowed origins
# are https://sendpotion.com, https://www.sendpotion.com and
# https://blog.sendpotion.com. Neither is committed: this repo is public.
VOQALIZE_AGENT_ID=
VOQALIZE_PUBLISHABLE_KEY=
