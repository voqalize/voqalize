    "@voqalize/client-transport": "0.4.1",
    "@voqalize/demo-kit": "file:../../shared",
    "@voqalize/stage": "link:../../../sdk/js/stage",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
