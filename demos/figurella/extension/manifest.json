{
  "manifest_version": 3,
  "name": "Javier for Figurella — Voqalize preview",
  "version": "0.0.0",
  "description": "A voice guide on figurella.cl, in Spanish or English, who walks a visitor through the Figurella method, the plans, the success stories and the agreements while her screen follows his voice, finds her nearest branch, and fills in the booking form for her free body diagnosis as she dictates it; she presses the button herself. A Voqalize preview.",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://figurella.cl/*", "https://www.figurella.cl/*"],
      "js": ["bridge.js", "anchor.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://figurella.cl/*", "https://www.figurella.cl/*"],
      "js": ["shell.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://figurella.cl/*", "https://www.figurella.cl/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://figurella.cl/*", "https://www.figurella.cl/*"],
  "web_accessible_resources": [
    {
      "resources": ["grant.html", "grant.js"],
      "matches": ["https://figurella.cl/*", "https://www.figurella.cl/*"]
    }
  ]
}
