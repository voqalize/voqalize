# Wiring for this demo's frontend (Vite inlines VITE_* at build). Copy to `.env`
# and fill in per-environment values, or provision via the MCP `set_brain_url`
# flow. All demos share one tenant; this demo needs its agent id + publishable key.
# The umbrella build (demos/build.mjs) maps VITE_ORDERDESK_AGENT / VITE_ORDERDESK_PK
# onto these generic names.
VITE_TENANT=demo
VITE_AGENT_ID=
VITE_PUBLISHABLE_KEY=
