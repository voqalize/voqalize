{
  "manifest_version": 3,
  "name": "Javier para PC Factory — Voqalize preview",
  "version": "0.0.0",
  "description": "A voice guide on pcfactory.cl who finds notebooks, parts and phones with the visitor, filters and sorts the listings, opens products and their specifications, reads live prices and stock by store, adds to the cart and takes a guest as far as Tipo de entrega (never a login, a RUT or the payment), in Spanish or English. A Voqalize preview.",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pcfactory.cl/*", "https://pcfactory.cl/*"],
      "js": ["bridge.js", "anchor.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.pcfactory.cl/*", "https://pcfactory.cl/*"],
      "js": ["shell.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.pcfactory.cl/*", "https://pcfactory.cl/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://www.pcfactory.cl/*", "https://pcfactory.cl/*"],
  "web_accessible_resources": [
    { "resources": ["grant.html", "grant.js"], "matches": ["https://www.pcfactory.cl/*", "https://pcfactory.cl/*"] }
  ]
}
