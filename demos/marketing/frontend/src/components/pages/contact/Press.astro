---
import Email from '../../Email.astro';
// Press (#press; /press redirects here). The short description with a copy button and the
// company facts, the press kit (logos, app icons and character stills that exist in public/,
// with format and size), and the way to ask: an email with "Press" in the subject. No motion here.
import { logos, icons, characters } from '../../../data/contact';
const name = (c: string) => c[0].toUpperCase() + c.slice(1);
---
<section class="pg-block ct-press" id="press" aria-labelledby="t-press" data-part="press">
  <header class="s-head">
    <p class="eyebrow">Press</p>
    <h2 id="t-press">Writing about Voqalize?</h2>
    <p class="s-lede">Here is the short version, the logos, the app icons and the characters. For anything else, write to <Email />.</p>
  </header>

  <div class="ct-press__grid">
    <article class="ct-about">
      <h3>About Voqalize</h3>
      <p id="ct-boiler">Voqalize is voice AI infrastructure that lets businesses add two-way voice conversations to their applications and agents. With Plug &amp; Play, Voqalize manages the agent and the voice experience for you. With developer integration, teams keep their own agent and workflows and add Voqalize's voice to their backend. Learn more at voqalize.com.</p>
      <button class="btn btn--ghost btn--sm" type="button" data-copy-from="#ct-boiler">Copy this paragraph</button>
      <dl class="ct-facts">
        <div><dt>Company</dt><dd>Voqalize Technologies Private Limited</dd></div>
        <div><dt>Based in</dt><dd>Bengaluru, India</dd></div>
        <div><dt>Co-founders</dt><dd>Samkeet Jain, Sripathi Krishnan, Swetha Suresh</dd></div>
        <div><dt>Press contact</dt><dd><Email /></dd></div>
      </dl>
    </article>

    <div class="ct-kit">
      <h3>Press kit</h3>
      <p class="ct-kit__rule">Keep the V and O in their gradient, leave the height of the O clear on every side, don't recolor the wordmark, and don't resize the VO and the wordmark separately.</p>
      <ul class="ct-logos">
        {logos.map((l) => (
          <li>
            <a class={`ct-logo ct-logo--${l.ground}`} href={l.file} download>
              <span class="ct-logo__img"><img src={l.small} alt="" loading="lazy" /></span>
              <span class="ct-logo__name">{l.name}</span>
              <span class="ct-logo__meta">{l.format}, {l.size} px <span class="ct-dl">Download</span></span>
            </a>
          </li>
        ))}
      </ul>

      <h4 class="ct-kit__h">App icons</h4>
      <ul class="ct-icons">
        {icons.map((ic) => (
          <li>
            <a class="ct-icon" href={ic.file} download>
              <span class="ct-icon__img"><img src={ic.small} alt="" width="256" height="256" loading="lazy" /></span>
              <span class="ct-logo__name">{ic.name}</span>
              <span class="ct-logo__meta">PNG, {ic.size} px <span class="ct-dl">Download</span></span>
            </a>
          </li>
        ))}
      </ul>

      <h4 class="ct-kit__h">Characters</h4>
      <p class="ct-kit__rule">The characters belong to Voqalize. Use these images for coverage of Voqalize only.</p>
      <ul class="ct-cast" aria-label="Character stills">
        {characters.map((c) => (
          <li>
            <a href={`/characters/${c}.webp`} download>
              <img src={`/characters/${c}.webp`} alt="" width="256" height="256" loading="lazy" />
              <span class="ct-cast__name">{name(c)}</span>
              <span class="ct-logo__meta">WebP, 256 px</span>
            </a>
          </li>
        ))}
      </ul>

    </div>
  </div>

  <div class="ct-ask">
    <p><strong>Questions about a story?</strong> Write to <Email /> with “Press” in the subject line.</p>
  </div>
</section>
