---
// One numbered section of a legal document: an anchor-linked heading ("12. Security", with a #
// link that appears on hover or focus), an optional plain-language "In short" line, then the
// legal text. `level` picks h2 (DPA sections) or h3 (sections inside Part A or Part B).
interface Props { id: string; n: string; title: string; short?: string; level?: 2 | 3 }
const { id, n, title, short, level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
---
<section class="lg-sec" id={id} aria-labelledby={`${id}-h`}>
  <H class="lg-sec__h" id={`${id}-h`}><span class="lg-sec__n">{n}.</span> {title}<a class="lg-anchor" href={`#${id}`} aria-label={`Link to section ${n}, ${title}`}>#</a></H>
  {short && <p class="lg-short"><b>In short.</b> {short}</p>}
  <div class="lg-body"><slot /></div>
</section>
