---
import Email from '../../Email.astro';
// Where to go next: report a vulnerability (write to the address, subject "Security"), request the
// security documents (fine print with the address), and the legal pages (privacy, DPA). Static.
// No mailto links anywhere on the site: the address as text with a Copy button (Email.astro).
---
<section class="pg-block sec-next" aria-labelledby="sec-next-t" data-part="report">
  <header class="s-head">
    <p class="eyebrow">Talk to us</p>
    <h2 id="sec-next-t">Get in touch about security.</h2>
  </header>
  <div class="sec-next__grid">
    <article class="sec-card">
      <h3>Report a vulnerability</h3>
      <p>Write to <Email /> with the subject “Security”. Tell us what you found and how to reproduce it, and give us a fair chance to fix it before you share it.</p>
    </article>
    <article class="sec-card">
      <h3>Request our security documents</h3>
      <p>Ask for our certificates and audit reports, or send us your security questionnaire. Tell us a little about your company and what you need.</p>
      <p class="sec-card__fine">To request them, please reach out to <Email size="fine" />.</p>
    </article>
    <article class="sec-card">
      <h3>The legal side</h3>
      <p>How we collect and use personal data, and the terms we sign when we process data on your behalf.</p>
      <ul class="sec-card__links">
        <li><a href="/privacy">Privacy policy</a></li>
        <li><a href="/dpa">Data processing addendum</a></li>
      </ul>
    </article>
  </div>
</section>
