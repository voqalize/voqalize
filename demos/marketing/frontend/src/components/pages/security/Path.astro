---
// One sentence through a call: the motion piece of the page, kept calm.
// Left: the five steps as text (this carries the meaning; the current one is marked).
// Right (decoration, aria-hidden): five labeled layers stacked on a spine. Each step
// fills the next layer with what that layer sees of the same sentence.
//   s0  your customer's app: the waveform and what they said
//   s1  in transit: the same voice as encrypted bytes, DTLS-SRTP
//   s2  our speech servers: the words as text
//   s3  your AI agent: the action it picks and the reply
//   s4  back on screen: the reply spoken (no waveform: waveforms are the person's), the appointment moved
//   s5  the foot: recording off, no audio kept from this call
// Reduced motion shows s5, every layer filled.
const steps = [
  { t: 'Your customer speaks.', d: 'The microphone opens when they start a call in your app.' },
  { t: 'Encrypted in transit.', d: 'Their voice travels to us over WebRTC, encrypted with DTLS‑SRTP.' },
  { t: 'Heard by our speech servers.', d: 'Speech becomes text on servers we operate. No outside speech company hears it.' },
  { t: 'Answered by your AI agent.', d: 'The words go to your agent, on your own servers, or to the one we run for you with Plug & Play. It decides what to say and what the app should do.' },
  { t: 'Spoken back, and done.', d: 'Your customer hears the answer, and the app moves the appointment.' },
];
const bars = [6, 12, 20, 14, 24, 10, 18, 26, 12, 8, 16, 22, 10, 6, 14, 20, 12, 8];
---
<section class="pg-block sec-path" aria-labelledby="sec-path-t" data-part="call">
  <header class="s-head">
    <p class="eyebrow">During a call</p>
    <h2 id="sec-path-t">One sentence, start to finish.</h2>
    <p class="s-lede">Here is what happens to one thing your customer says, and who handles it along the way.</p>
  </header>

  <div class="sec-path__box" data-loop="2600 2600 2800 3000 2800 4600">
    <ol class="sec-path__steps">
      {steps.map((s, i) => (
        <li class={`k${i + 1}`}>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>

    <div class="sec-path__stage" aria-hidden="true">
      <div class="sl b1">
        <p class="sl__label"><i></i>Your customer’s app</p>
        <div class="sl__body">
          <svg class="sl__wave" viewBox="0 0 108 28">{bars.map((h, i) => <rect x={i * 6} y={(28 - h) / 2} width="3" height={h} rx="1.5" />)}</svg>
          <span class="sl__said">“Can you move my appointment to Friday?”</span>
        </div>
      </div>
      <div class="sl b2">
        <p class="sl__label"><i></i>In transit</p>
        <div class="sl__body">
          <svg class="sl__lock" viewBox="0 0 16 18"><rect x="1.5" y="8" width="13" height="9" rx="2" /><path d="M4.5 8V5.5a3.5 3.5 0 0 1 7 0V8" /></svg>
          <span class="sl__bytes">9f 3a c1 07 e4 5b 2d 88 71 0c a6 f2 19 b0 4e 63 d7 2a 95 1c</span>
          <span class="sl__tag">DTLS-SRTP</span>
        </div>
      </div>
      <div class="sl b3">
        <p class="sl__label"><i></i>Our speech servers</p>
        <div class="sl__body">
          <span class="sl__text">can you move my appointment to friday</span>
          <span class="sl__tag">text</span>
        </div>
      </div>
      <div class="sl b4">
        <p class="sl__label"><i></i>Your AI agent</p>
        <div class="sl__body sl__body--two">
          <span class="sl__act">Action: move appointment to Friday, 10:00</span>
          <span class="sl__reply">“Done. You’re booked for Friday at 10.”</span>
        </div>
      </div>
      <div class="sl b5">
        <p class="sl__label"><i></i>Back on screen</p>
        <div class="sl__body">
          <span class="sl__heard">Spoken reply</span>
          <span class="sl__done"><svg viewBox="0 0 14 14"><path d="M2.5 7.5l3 3 6-7" /></svg>Appointment moved: Friday, 10:00</span>
        </div>
      </div>
      <p class="sl__foot"><span class="sl__rec"><i></i>Recording off</span>No audio is saved from this call.</p>
    </div>
  </div>
</section>
