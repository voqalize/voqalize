---
// The hero's motion piece: the belief "software should listen more than it talks", acted out.
// One example conversation, then the count of who did the talking.
// Steps: 0 empty frame; 1 the customer asks for Thursday (the app listens); 2 a pause, and the app
// keeps waiting instead of jumping in; 3 "mornings are better for me"; 4 "actually, skip next week
// too" (the change of mind is marked); 5 the app answers in one short line (the ring ripples, the
// waveform belongs to the person only); 6 both changes land on screen, ticked; 7 the tally: 17 words
// from the customer, 8 from the app, and the hold.
// Decoration only (aria-hidden): the page's text carries the meaning.
const said = [
  { t: 'Can you move my delivery to Thursday?', bars: 14 },
  { t: 'Mornings are better for me.', bars: 10 },
  { t: 'Actually, skip next week too.', bars: 11 },
];
// Seeded bar heights so the waveform looks spoken but stays the same on every build.
let seed = 11;
const rnd = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };
const wave = said.map((s) => Array.from({ length: s.bars }, (_, i) => {
  const env = Math.sin(Math.PI * (i + 0.5) / s.bars);
  return Math.round(Math.max(0.16, env * (0.4 + rnd() * 0.6)) * 100);
}));
const states = ['Listening', 'A pause. Still listening.', 'Listening', 'Heard a change. Listening.', 'Speaking', 'Changing it on screen', 'Listening again'];
---
<div class="ab-talk" data-loop="500 2400 1600 1700 2200 2400 1900 7000" aria-hidden="true">
  <p class="ab-talk__k">One conversation</p>

  <div class="ab-row ab-row--you">
    <span class="ab-who">Customer</span>
    <div class="ab-wave">
      {wave.map((seg, k) => (
        <span class={`ab-seg ab-seg${k + 1}`}>
          {seg.map((h, i) => <i style={`--h:${h}%;--d:${(i * 0.045).toFixed(3)}s`}></i>)}
        </span>
      ))}
      <span class="ab-gap">pause</span>
    </div>
    <p class="ab-said">
      <span class="ab-w ab-w1">{said[0].t}</span>{' '}
      <span class="ab-w ab-w2">{said[1].t}</span>{' '}
      <span class="ab-w ab-w3"><b>Actually<svg viewBox="0 0 100 12" preserveAspectRatio="none"><path pathLength="1" d="M2 7 C 30 3, 60 9, 98 4" /></svg></b>, skip next week too.</span>
    </p>
  </div>

  <div class="ab-row ab-row--app">
    <span class="ab-face"><img src="/characters/tanvi.webp" alt="" width="256" height="256" loading="lazy" /></span>
    <div class="ab-app">
      <span class="ab-who">Your app</span>
      <span class="ab-states">{states.map((s, i) => <span class={`ab-st ab-st${i + 1}`}>{s}</span>)}</span>
      <p class="ab-reply">Done. Thursday mornings, and next week is off.</p>
    </div>
  </div>

  <ul class="ab-acts">
    <li class="ab-act ab-act1"><i></i>Delivery day: Thursday, morning</li>
    <li class="ab-act ab-act2"><i></i>Next week: skipped</li>
  </ul>

  <div class="ab-tally">
    <p class="ab-tally__k">Who did the talking</p>
    <p class="ab-bar ab-bar--you"><span>Customer</span><b style="--w:100%"></b><em>17 words</em></p>
    <p class="ab-bar ab-bar--app"><span>Your app</span><b style="--w:47%"></b><em>8 words</em></p>
  </div>
</div>
