---
// The people: everyone in one grid, the same card for all (the co-founders first, then the
// team, with no split between them: Samkeet, 2026-10-12). Everyone comes from src/data/team.ts,
// so adding a person or a photo is a one-file edit.
// Motion (decoration only): step 0 the photo frames are scattered and tipped like prints
// dropped on a table; 1 they settle one after another; 2 the vermilion listening ring draws
// round each face in turn; 3 the "Photo coming" tags pop on, and the hold.
// Names, roles and lines never move, so the text reads at every step.
import Portrait from './Portrait.astro';
import { PEOPLE } from '../../../data/team';
const loop = '300 1500 1700 120000';
const tilt = [-6, 4, -3, 5, -4, 3, -5, 6, -2, 4];
---
<section class="pg-block ab-people" aria-labelledby="ab-people-t" data-part="people">
  <header class="s-head">
    <p class="eyebrow">The people</p>
    <h2 id="ab-people-t">Who's building it.</h2>
  </header>

  <ul class="ab-grid" data-loop={loop}>
    {PEOPLE.map((p, i) => (
      <li class="ab-card" style={`--i:${i};--r:${tilt[i % tilt.length]}deg`}>
        <Portrait person={p} />
        <div class="ab-card__text">
          <h3>{p.name}</h3>
          <p class="ab-role">{p.role}</p>
          {p.line && <p class="ab-line">{p.line}</p>}
          {p.bio && <p class="ab-bio">{p.bio}</p>}
          {p.links && p.links.length > 0 && (
            <p class="ab-links">{p.links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}</p>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>
