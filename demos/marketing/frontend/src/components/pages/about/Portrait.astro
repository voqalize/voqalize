---
// One person's photo slot: the same square frame for everyone, sized for the cartoon portraits to come.
// With a photo it shows the photo. Without one it draws a placeholder on purpose: the person's initials
// set large on warm white, a drawn head-and-shoulders line, the vermilion listening ring (drawn in by
// the People loop), and a "Photo coming" tag.
import { initials, type Person } from '../../../data/team';
interface Props { person: Person; size?: 'lg' | 'sm' }
const { person, size = 'sm' } = Astro.props;
---
<figure class={`ab-pic ab-pic--${size}`}>
  {person.photo ? (
    <img src={person.photo} alt={`Portrait of ${person.name}`} width="800" height="800" loading="lazy" decoding="async" />
  ) : (
    <div class="ab-pic__ph" aria-hidden="true">
      <span class="ab-pic__ini">{initials(person.name)}</span>
      <svg class="ab-pic__fig" viewBox="0 0 100 100" preserveAspectRatio="xMidYMax meet">
        <circle cx="50" cy="44" r="15" />
        <path d="M18 100 C 20 78, 34 66, 50 66 C 66 66, 80 78, 82 100" />
      </svg>
      <svg class="ab-pic__ring" viewBox="0 0 100 100"><circle cx="50" cy="44" r="23" pathLength="1" /></svg>
      <span class="ab-pic__tag">Photo coming</span>
    </div>
  )}
</figure>
