---
// Our story, the opening: the headline, the lede, and the chapter index. Under the index runs
// a live waveform in the Voice Gradient (this view's one use of it): the bars draw in from the
// left once, then breathe like a voice. Decoration only; the index links carry the meaning.
import { CHAPTERS } from '../../../data/story';
// Deterministic bar heights, so every build draws the same voice.
let seed = 11;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const BARS = 72;
const bars = Array.from({ length: BARS }, (_, i) => {
  const env = 0.35 + 0.65 * Math.abs(Math.sin((i / BARS) * Math.PI * 3.1));
  return Math.max(0.14, env * (0.4 + rnd() * 0.6));
});
---
<header class="st-hero" data-part="hero">
  <p class="pg-crumb"><a href="/">Voqalize</a> / Company</p>
  <p class="eyebrow">Our story</p>
  <h1>We spent two years on the <span class="st-mk">hard part</span> of voice.</h1>
  <p class="s-lede">We set out to build voice products, and most of the work turned out to be underneath them. Here’s how it turned into Voqalize, and why we’re letting other teams build on it today.</p>

  <nav class="st-index" aria-label="Chapters">
    <ol>
      {CHAPTERS.map((c) => <li><a href={`#${c.id}`}><span class="st-index__n">{c.n}</span>{c.short}</a></li>)}
    </ol>
    <svg class="st-wave" viewBox={`0 0 ${BARS * 10} 60`} preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="st-grad" x1="0" x2="1" y1="0" y2="0">
          {['#FD873F', '#FD6E43', '#FD5446', '#FD394A', '#F92158', '#ED0B65', '#D1056C', '#AC0162'].map((c, i) => <stop offset={i / 7} stop-color={c} />)}
        </linearGradient>
      </defs>
      <g fill="url(#st-grad)">
        {bars.map((h, i) => <rect x={i * 10 + 2} y={30 - h * 28} width="5" height={h * 56} rx="2.5" style={`--i:${i}`} />)}
      </g>
    </svg>
  </nav>
</header>
