---
// Chapter 5: the stack, for other teams. The stack we built stays put; the product on top
// changes. It starts as "Our voice products", then the box lifts off and another team's
// product lands in its place, plugging into the same stack each time.
// Steps: 0 "Our voice products"; 1 "Your agent"; 2 "Your store"; 3 "Your app" (and rest).
const tops = ['Our voice products', 'Your agent', 'Your store', 'Your app'];
---
<div class="st-swap st-frame" data-loop="2600 2300 2300 9000" aria-hidden="true">
  <div class="st-swap__top">
    {tops.map((t, i) => <span class={`sw sw${i}`}>{t}</span>)}
  </div>
  <span class="st-swap__plug"></span>
  <div class="st-swap__stack">
    {Array.from({ length: 8 }, (_, i) => <i style={`--i:${i}`}></i>)}
    <p><img class="logo-on-light" src="/brand/logo-light.png" alt="" width="108" height="36" /><img class="logo-on-dark" src="/brand/logo-dark.png" alt="" width="108" height="36" /></p>
  </div>
</div>
