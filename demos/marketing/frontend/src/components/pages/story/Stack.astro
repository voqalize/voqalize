---
// Chapter 3: building underneath. The layers go down one at a time, bottom first, beside a
// rule that runs from "Two years ago" to "Today". On top, the sentence that kept breaking:
// it starts broken (the product's answer struck through) and goes through cleanly once the
// last layer is in.
// Steps: 0 the broken sentence, no layers; 1 to 8 one layer each (it drops in and lands);
// 9 the sentence goes through (answer, tick); 10 hold.
// The layer list is real content (read in order, bottom up); the sentence on top is decoration.
const LAYERS = [
  { h: 'Audio that gets through a bad signal', p: 'Microphones, WebRTC, every browser, a weak connection on a train.' },
  { h: 'Hearing only the person', p: 'Noise, echo, and the product’s own voice coming back through the speaker.' },
  { h: 'Getting the words right', p: 'Names, numbers, addresses, two languages in one sentence.' },
  { h: 'Knowing when they’ve finished', p: 'A pause to think, or the end of the sentence.' },
  { h: 'Stopping when they cut in', p: 'On the word, and remembering only what they heard.' },
  { h: 'A voice that starts fast', p: 'Speech that begins while the reply is still being written.' },
  { h: 'A character that moves with it', p: 'A face whose lips match the voice.' },
  { h: 'A record of every conversation', p: 'Recordings to go back to.' },
];
---
<div class="st-stack st-frame" data-loop={['900', ...LAYERS.map(() => '1000'), '1600', '7000'].join(' ')}>
  <div class="st-stack__top" aria-hidden="true">
    <span class="st-pill">Actually, make it Friday.</span>
    <span class="st-pill st-pill--a"><s>Thursday at 10 is free, and</s><b>Moved to Friday.</b><i class="st-stack__tick"></i></span>
  </div>
  <div class="st-stack__body">
    <div class="st-stack__time" aria-hidden="true"><span>Today</span><i></i><span>Two years ago</span></div>
    <ol class="st-stack__layers">
      {LAYERS.map((l, i) => <li class={`ly ly${i + 1}`} style={`--i:${i}`}><b>{l.h}</b><span>{l.p}</span></li>)}
    </ol>
  </div>
</div>
