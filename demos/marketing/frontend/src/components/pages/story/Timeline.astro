---
// A tiny conversation timeline, shared by chapters 1 and 2: one row per speaker (Person,
// Product, sometimes the TV). People and the TV get waveform bars; the product gets a solid
// vermilion band (brand: the waveform belongs to the person). What was said sits underneath. Marks sit on top: a hatched overlap where two voices
// collide, a bracket over a pause, a dashed "should have stopped here" line.
// Everything starts hidden and plays when the parent turns on `play` (a class from the
// chapter's step loop); `--d` staggers each part by where it sits in time, so the call
// plays left to right. Positions are fractions of the track (0 to 1).
export interface Seg { a: number; b: number; say?: string; faded?: boolean; flat?: boolean }
export interface Row { who: string; kind?: 'p' | 'a' | 'tv'; segs: Seg[] }
export interface Mark { type: 'hatch' | 'bracket' | 'stop'; a: number; b?: number; label?: string; rows?: [number, number] }
interface Props { rows: Row[]; marks?: Mark[]; seed?: number; span?: number }
const { rows, marks = [], seed: s0 = 7, span = 2.2 } = Astro.props;
let seed = s0;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const bars = (a: number, b: number) => {
  const n = Math.max(3, Math.round((b - a) * 46));
  return Array.from({ length: n }, (_, i) => {
    const f = a + ((b - a) * (i + 0.5)) / n;
    const env = Math.sin((Math.PI * (i + 0.5)) / n);
    return { x: f, h: Math.max(0.14, env * (0.35 + rnd() * 0.65)) };
  });
};
const d = (x: number) => (0.15 + x * span).toFixed(2);
const pct = (x: number) => `${(x * 100).toFixed(2)}%`;
---
<div class="tl" style={`--rows:${rows.length}`}>
  {rows.map((r) => (
    <div class={`tl__row tl__row--${r.kind ?? 'p'}`}>
      <span class="tl__who">{r.who}</span>
      <div class="tl__track">
        <span class="tl__axis"></span>
        {r.segs.map((sg) => (
          <>
            {sg.flat
              ? <span class="tl__flat" style={`left:${pct(sg.a)};width:${pct(sg.b - sg.a)};--d:${d(sg.a)}s`}></span>
              : r.kind === 'a'
              ? <span class="tl__band" style={`left:${pct(sg.a)};width:${pct(sg.b - sg.a)};--d:${d(sg.a)}s`}></span>
              : bars(sg.a, sg.b).map((b) => <i class:list={['tl__bar', { 'is-faded': sg.faded }]} style={`left:${pct(b.x)};--h:${b.h.toFixed(2)};--d:${d(b.x)}s`}></i>)}
            {sg.say && <span class:list={['tl__say', { 'is-faded': sg.faded, 'is-end': sg.a > 0.45 }]} style={sg.a > 0.45 ? `right:${pct(1 - sg.b)};max-width:${pct(sg.b)};--d:${d(sg.a)}s` : `left:${pct(sg.a)};max-width:${pct(1 - sg.a)};--d:${d(sg.a)}s`}>{sg.say}</span>}
          </>
        ))}
      </div>
    </div>
  ))}
  {marks.map((m) => (
    <span class={`tl__mark tl__mark--${m.type}`} style={`--a:${m.a};--b:${m.b ?? m.a};--r0:${m.rows?.[0] ?? 0};--r1:${m.rows?.[1] ?? rows.length - 1};--d:${d(m.a)}s`}>
      {m.label && <em>{m.label}</em>}
    </span>
  ))}
</div>
