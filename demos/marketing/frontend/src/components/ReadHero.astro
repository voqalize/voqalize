---
import { OPENING_LINES } from '../data/lines';
---
<section class="read-hero" id="s-arrival" aria-labelledby="hero-title">
  <div>
    <h1 id="hero-title">{OPENING_LINES[0]}</h1>
    <!-- A different opening line on each visit; the Talk guide shows the same one. -->
    <script is:inline define:vars={{ lines: OPENING_LINES }}>
      window.__vqLine = window.__vqLine || lines[Math.floor(Math.random() * lines.length)];
      document.getElementById('hero-title').textContent = window.__vqLine;
    </script>
    <p class="descriptor">
      <span class="descriptor__lead">Give your software a voice that</span>
      <span class="descriptor__verbs"><span class="verb">Sees</span>, <span class="verb">Listens</span>, <span class="verb">Understands</span><span class="and"> and </span><span class="verb">Acts</span>.</span>
    </p>
    <div class="hero-actions">
      <button type="button" class="btn" data-talk>Talk to Tanvi</button>
      <a class="btn btn--ghost" href="#s-action">See how it works</a>
    </div>
  </div>
  <div class="read-hero__face">
    <!-- Her idle loop, recorded from the avatar renderer, so she is alive in Read mode too. -->
    <video class="read-hero__tanvi" data-autoplay muted loop playsinline poster="/characters/tanvi.webp" width="280" height="300" aria-label="Tanvi, a Voqalize character">
      <source src="/characters/loops/tanvi.webm" type="video/webm" />
      <source src="/characters/loops/tanvi.mp4" type="video/mp4" />
    </video>
    <canvas class="ribbon" id="ribbon-read" aria-hidden="true"></canvas>
    <p>Tanvi can walk you through this page. Switch to Talk at any time.</p>
  </div>
</section>
