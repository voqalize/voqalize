---
// Banking hero: one sentence with a condition in it, shown as Voice > Understanding > Action.
// Three rows on a thin rail: Heard (the spoken line), Understood (the three things the app
// took from it, lettered), Ready (Tidewell Bank's transfer card filling in, then the customer's
// own tap on Confirm). The rail fills as the loop moves down. Decorative: the hero lede says it.
// Steps: 0 idle card, 1 said, 2 words marked and chips in, 3 fields filled,
//        4 Tushar's reply and Confirm waits, 5 the tap, Scheduled.
import Voice from '../../Voice.astro';
const STEPS = [1400, 2400, 2400, 2200, 3000, 3400];
---
<div class="bkh" data-loop={STEPS.join(' ')} aria-hidden="true">
  <div class="bkh__rail"><i></i></div>
  <p class="bkh__ex">Example</p>

  <div class="bkh__row bkh__row--heard">
    <p class="bkh__k"><span>1</span>Heard</p>
    <Voice who="person" class="sol-said bkh__said">Move <u class="bkh-w bkh-w1">$500</u> to <u class="bkh-w bkh-w2">savings</u> on <u class="bkh-w bkh-w3">Friday, after my paycheck lands</u>.</Voice>
  </div>

  <div class="bkh__row bkh__row--got">
    <p class="bkh__k"><span>2</span>Understood</p>
    <ul class="bkh__chips">
      <li class="bkh-c bkh-c1"><b>a</b>Amount <em>$500</em></li>
      <li class="bkh-c bkh-c2"><b>b</b>To <em>Savings ··· 0937</em></li>
      <li class="bkh-c bkh-c3"><b>c</b>When <em>Fri, Oct 17, after payroll posts</em></li>
    </ul>
  </div>

  <div class="bkh__row bkh__row--done">
    <p class="bkh__k"><span>3</span>Ready</p>
    <div class="bkh__card">
      <p class="bkh__app"><span class="dev__mark">T</span><b>Tidewell Bank</b><small>Transfer</small></p>
      <dl class="bkh__fields">
        <div><dt>From</dt><dd>Checking ··· 4521</dd></div>
        <div class="bkh-f bkh-f2"><dt>To</dt><dd><b>b</b><em>Savings ··· 0937</em></dd></div>
        <div class="bkh-f bkh-f1"><dt>Amount</dt><dd><b>a</b><em>$500.00</em></dd></div>
        <div class="bkh-f bkh-f3"><dt>Date</dt><dd><b>c</b><em>Fri, Oct 17 · after payroll</em></dd></div>
      </dl>
      <p class="bkh__go"><span class="bkh__btn">Confirm transfer<i class="bkh__tap"></i></span><span class="bkh__ok"><svg viewBox="0 0 12 12"><path d="M2.5 6.2l2.3 2.3 4.7-5"/></svg>Scheduled for Friday</span></p>
    </div>
    <Voice who="agent" face="/characters/tushar.webp" class="r-at-4 bkh__reply">Ready for Friday, right after your pay lands. Confirm to schedule it.</Voice>
  </div>
</div>
