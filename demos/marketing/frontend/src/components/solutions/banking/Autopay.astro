---
// Scene 2, Autopay: the new car loan's account page, autopay off. On the request the app reads
// the pay deposits (payroll on the 15th, marked), puts the 15th, the 16th and the due date on a
// week strip, fills the autopay (account, amount, the 16th), then waits on Confirm. The
// customer's tap turns it on.
// Steps: 0 loan page, 1 said, 2 payday found, 3 autopay filled, 4 reply + Confirm waits, 5 tap, on.
import Device from '../Device.astro';
import Voice from '../../Voice.astro';
const DAYS = [13, 14, 15, 16, 17, 18, 19, 20];
---
<Device kind="phone" app="Tidewell Bank" class="bkp">
  <div class="bkp-loan">
    <p class="bkp-k">Auto loan ··· 2290</p>
    <p class="bkp-v">$18,000</p>
    <p class="bkp-due"><span>Next payment</span><b>$347 · due Nov 20</b></p>
    <p class="bkp-row"><span>Autopay</span><i class="bkp-tg"></i><em class="bkp-st">Off</em></p>
  </div>
  <div class="bkp-dep">
    <p class="bkp-h">Deposits to checking</p>
    <p class="bkp-d"><span>Payroll · Oct 15</span><b>+$3,100</b></p>
    <p class="bkp-d"><span>Payroll · Sep 15</span><b>+$3,100</b></p>
  </div>
  <div class="bkp-week">
    {DAYS.map((d) => (
      <span class={`bkp-day bkp-day--${d}`}><b>{d}</b>{d === 15 && <small>Pay</small>}{d === 16 && <small>Car</small>}{d === 20 && <small>Due</small>}</span>
    ))}
  </div>
  <div class="bkp-form">
    <p class="bkp-h">Autopay</p>
    <p class="bkp-f"><span>From</span><em>Checking ··· 4521</em></p>
    <p class="bkp-f"><span>Amount</span><em>$347.00</em></p>
    <p class="bkp-f"><span>Every month on</span><em>The 16th</em></p>
    <p class="bkp-go"><span class="bkp-btn">Confirm autopay<i class="bkp-tap"></i></span><span class="bkp-ok"><svg viewBox="0 0 12 12"><path d="M2.5 6.2l2.3 2.3 4.7-5"/></svg>Autopay on</span></p>
  </div>
  <Fragment slot="dock">
    <Voice who="person" class="sol-said out-at-4">Pay the car loan from checking every month, the day after my paycheck.</Voice>
    <Voice who="agent" face="/characters/tushar.webp" class="r-at-4">Your pay lands on the 15th, so $347 goes out on the 16th, four days before it's due. Confirm and it's set.</Voice>
  </Fragment>
</Device>
