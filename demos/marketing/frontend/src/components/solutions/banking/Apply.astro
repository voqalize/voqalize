---
// Scene 1, Apply: Tidewell Bank's pre-qualified car loan offer. On the request the application
// slides in and fills itself: identity from the profile, then income and employer from the
// pay deposits (each group tagged with where it came from). It stops at Submit, ringed, and
// waits for the customer.
// Steps: 0 the offer, 1 said, 2 profile fields fill, 3 income fields fill, 4 Submit waits + reply.
import Device from '../Device.astro';
import Voice from '../../Voice.astro';
const PROFILE = [
  { k: 'Full name', v: 'Jordan Ellis' },
  { k: 'Home address', v: '214 Alder Ave, Columbus, OH' },
  { k: 'Phone', v: '(614) 555 0142' },
];
const PAY = [
  { k: 'Employer', v: 'Brightline Logistics' },
  { k: 'Monthly income', v: '$6,200' },
];
---
<Device kind="phone" app="Tidewell Bank" class="bka">
  <div class="bka-offer">
    <p class="bka-tag">Pre-qualified</p>
    <p class="bka-offer__k">Auto loan offer</p>
    <p class="bka-offer__v">$18,000</p>
    <p class="bka-offer__r">5.9% APR · 60 months</p>
    <p class="bka-offer__m"><span>Monthly payment</span><b>$347</b></p>
    <p class="bka-offer__btn">Apply</p>
  </div>
  <div class="bka-form">
    <p class="bka-form__t">Auto loan application</p>
    <p class="bka-form__sub">$18,000 · 5.9% APR · 60 months</p>
    <p class="bka-src bka-src--1">From your profile</p>
    {PROFILE.map((f, i) => (
      <p class="bka-f bka-f--p" style={`--i:${i}`}><span>{f.k}</span><em>{f.v}</em></p>
    ))}
    <p class="bka-src bka-src--2">From your pay deposits</p>
    {PAY.map((f, i) => (
      <p class="bka-f bka-f--d" style={`--i:${i}`}><span>{f.k}</span><em>{f.v}</em></p>
    ))}
    <p class="bka-submit"><span>Submit application</span></p>
  </div>
  <Fragment slot="dock">
    <Voice who="person" class="sol-said out-at-4">Apply for the 5.9 percent loan. Use what you already have on me.</Voice>
    <Voice who="agent" face="/characters/tushar.webp" class="r-at-4">Filled from your profile and your pay deposits. Check it over, then tap Submit.</Voice>
  </Fragment>
</Device>
