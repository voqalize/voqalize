---
// Scene 3, a strange charge: the home screen weeks later, debit card on top, recent activity
// below. On the request the other rows fold away and the $89.99 charge opens with its details;
// the card frosts over (frozen, as asked); a dispute is drafted and waits on Send; then the app
// checks what the card pays for (the car autopay runs from checking, so it is unaffected).
// Steps: 0 home, 1 said, 2 charge found, 3 card frozen, 4 dispute waits, 5 what it touches + reply.
import Device from '../Device.astro';
import Voice from '../../Voice.astro';
const TX = [
  { n: 'Corner Coffee', w: 'Today', v: '−$4.50' },
  { n: 'QPX*DIGITAL SVCS', w: 'Last night', v: '−$89.99', hit: true },
  { n: 'Green Grocer', w: 'Yesterday', v: '−$84.20' },
  { n: 'Payroll', w: 'Nov 15', v: '+$3,100' },
  { n: 'Fuel Stop', w: 'Nov 14', v: '−$41.00' },
];
---
<Device kind="phone" app="Tidewell Bank" class="bkc">
  <div class="bkc-card">
    <span class="bkc-card__k">Debit card ··· 7716</span>
    <b class="bkc-card__v">Tidewell Debit</b>
    <span class="bkc-chip"></span>
    <span class="bkc-frost"><svg viewBox="0 0 16 16"><rect x="3.5" y="7" width="9" height="6.5" rx="1.5"/><path d="M5.5 7V5a2.5 2.5 0 015 0v2"/></svg>Frozen</span>
  </div>
  <p class="bkc-h">Recent</p>
  <ul class="bkc-tx">
    {TX.map((t) => (
      <li class={t.hit ? 'bkc-hit' : 'bkc-other'}>
        <p class="bkc-tx__row"><span>{t.n}<small>{t.w}</small></span><b>{t.v}</b></p>
        {t.hit && <p class="bkc-tx__more">Online · card not present · 11:42 pm<br />First charge from this merchant</p>}
      </li>
    ))}
  </ul>
  <div class="bkc-disp">
    <p class="bkc-disp__t">Dispute $89.99</p>
    <p class="bkc-disp__r">Reason: I don't recognize this charge</p>
    <p class="bkc-disp__go"><span class="bkc-btn">Send dispute</span><small>Waiting for you</small></p>
  </div>
  <div class="bkc-uses">
    <p class="bkc-h">What this card pays for</p>
    <p class="bkc-u"><span>Streamly · $12.99 a month</span><em>Paused</em></p>
    <p class="bkc-u bkc-u--ok"><span>Car loan autopay</span><em><svg viewBox="0 0 12 12"><path d="M2.5 6.2l2.3 2.3 4.7-5"/></svg>Checking, not affected</em></p>
  </div>
  <Fragment slot="dock">
    <Voice who="person" class="sol-said out-at-5">I don't know this $89.99 charge from last night. Freeze my card.</Voice>
    <Voice who="agent" face="/characters/tushar.webp" class="r-at-5">Your card is frozen. The car payment comes from checking, so it still goes out. The dispute is ready when you are.</Voice>
  </Fragment>
</Device>
