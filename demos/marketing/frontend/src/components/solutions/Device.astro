---
// A drawn screen for a motion piece: a phone, a browser window or a tablet.
// The default slot is the app's view; slot "dock" holds the spoken lines (<Voice>),
// which float over the bottom of the screen. Decorative: hidden from screen readers,
// so the scene's text must carry the meaning.
interface Props { kind?: 'phone' | 'browser' | 'tablet'; app?: string; url?: string; class?: string }
const { kind = 'phone', app = '', url = '', class: cls = '' } = Astro.props;
---
<div class={`dev dev--${kind} ${cls}`} aria-hidden="true">
  <div class="dev__screen">
    {kind === 'phone' && <div class="dev__status"><b>9:41</b><span><i></i><i></i><i></i></span></div>}
    {kind === 'browser' && <div class="dev__chrome"><i></i><i></i><i></i><span class="dev__url">{url}</span></div>}
    {app && <div class="dev__bar"><span class="dev__mark">{app.charAt(0)}</span><b>{app}</b><slot name="bar" /></div>}
    <div class="dev__view"><slot /></div>
    <div class="dev__dock"><slot name="dock" /></div>
  </div>
</div>
