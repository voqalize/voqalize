---
// The domain block: where a request goes. Three things a patient might say, and where
// each one lands: done in the app, sent to the care team, or "call 911". Real text (not
// decoration); the step loop only brings each row forward in turn.
// Steps: 0 all rows quiet, 1 the refill (app), 2 the swollen ankle (care team),
// 3 chest pain (911), 4 all three together.
import Voice from '../../Voice.astro';

const ROUTES = [
  { said: 'Send my refill to the pharmacy on Main Street.', to: 'Ready in your app', reply: 'Your refill request for Main Street Pharmacy is ready. Check it and tap Send.' },
  { said: 'My ankle is still swollen. Is that normal?', to: 'Sent to your care team', reply: "That's one for Dr. Patel's team. I've started a message to them with what you told me." },
  { said: 'I have chest pain right now.', to: 'Call 911', reply: 'Please call 911 now.' },
];
---
<section class="sol-block hr" aria-labelledby="hr-t" data-part="routes">
  <header class="s-head">
    <p class="eyebrow">Where requests go</p>
    <h2 id="hr-t">Paperwork stays in the app. Symptoms go to your care team.</h2>
    <p class="s-lede">You set the rules your agent follows. For a care app we start with three. No diagnosis and no medical advice. Anything about how someone feels goes to your care team. Anything that could be an emergency gets told to call 911.</p>
  </header>
  <ol class="hr-rows" data-loop="900 3000 3000 3200 4200">
    {ROUTES.map((r, i) => (
      <li class={`hr-row hr-row${i + 1}`}>
        <Voice who="person" class="hr-said">{r.said}</Voice>
        <span class="hr-arrow" aria-hidden="true"><i></i></span>
        <div class="hr-to">
          <p class={`hr-lane hr-lane--${i + 1}`}>{r.to}</p>
          <Voice who="agent" face="/characters/ira.webp" class="hr-reply">{r.reply}</Voice>
        </div>
      </li>
    ))}
  </ol>
  <p class="hr-foot">Also done in the app: finding an in-network doctor, booking a lab visit, updating an insurance card, paying a bill.</p>
</section>
