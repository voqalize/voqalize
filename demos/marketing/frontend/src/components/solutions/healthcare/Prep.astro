---
// Scene 2, the prep sheet: the night before, the visit screen. Carol asks about coffee;
// Ira opens the prep sheet her clinic sent, scrolls to the fasting line, marks it and
// answers from what the sheet says (no advice of its own).
// Steps: 0 visit screen, 1 said, 2 the sheet opens and scrolls, 3 the fasting line is
// marked, 4 Ira reads the answer back.
import Device from '../Device.astro';
import Voice from '../../Voice.astro';
---
<Device kind="phone" app="Willow Health">
  <div class="hp">
    <div class="hp-visit">
      <p class="hp-when">Tomorrow</p>
      <div class="hp-card">
        <b>Annual checkup and fasting lab work</b>
        <span>Thu, Oct 16 · 10:30 am</span>
        <span>Dr. Anita Patel · Willow Clinic, 2nd floor</span>
      </div>
      <ul class="hp-rows">
        <li class="hp-row hp-row--prep"><i class="hp-doc"></i>Prep instructions<small>PDF</small></li>
        <li class="hp-row"><i class="hp-pin"></i>Directions</li>
        <li class="hp-row"><i class="hp-clock"></i>Online check-in opens at 8 am</li>
      </ul>
    </div>
    <div class="hp-sheet">
      <p class="hp-back"><svg viewBox="0 0 10 10"><path d="M6.5 1.5L3 5l3.5 3.5"/></svg>Prep instructions</p>
      <div class="hp-page">
        <div class="hp-scroll">
          <p class="hp-ph">Getting ready for your lab work</p>
          <span class="ln"></span><span class="ln"></span><span class="ln ln--s"></span>
          <p class="hp-ph hp-ph--s">What to bring</p>
          <span class="ln"></span><span class="ln ln--m"></span><span class="ln"></span><span class="ln ln--s"></span>
          <p class="hp-ph hp-ph--s">Medicines</p>
          <span class="ln"></span><span class="ln ln--m"></span>
          <p class="hp-ph hp-ph--s">Eating and drinking</p>
          <p class="hp-hit"><span>Water only for 12 hours before your blood draw. No coffee, tea or juice.</span></p>
          <span class="ln"></span><span class="ln ln--m"></span><span class="ln"></span>
          <p class="hp-ph hp-ph--s">After your visit</p>
          <span class="ln"></span><span class="ln ln--s"></span>
        </div>
      </div>
    </div>
  </div>
  <Voice slot="dock" who="person" class="sol-said">Can I have my coffee before the blood test tomorrow?</Voice>
  <Voice slot="dock" who="agent" face="/characters/ira.webp" class="r-at-4">Your clinic's sheet says water only for 12 hours before your blood draw. Your draw is at 10:30 tomorrow morning.</Voice>
</Device>
