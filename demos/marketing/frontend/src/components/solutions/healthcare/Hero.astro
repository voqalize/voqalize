---
// Healthcare hero: the fridge note (launch post 13, "How to reschedule (for Mom)") beside
// the patient app. Carol says one sentence; the app does the steps itself and each step
// on her daughter's note is crossed off as it happens. Voice > Understanding > Action.
// Steps (motion.ts): 0 home with Tuesday's visit, 1 Carol speaks, 2 the visit opens and
// Reschedule is picked (note 1 to 4 crossed), 3 Thursday's morning slots, 10:30 marked
// (note 5 to 7), 4 Ira proposes, 5 Carol confirms: moved (note 8 and "call me").
// Decorative (aria-hidden): the hero's text and caption carry the meaning.
import Device from '../Device.astro';
import Voice from '../../Voice.astro';

const NOTE = ['open the app', 'tap Menu (3 lines, top left)', 'Appointments', 'Manage', 'the little pencil', 'Reschedule', 'scroll to Thursday', 'CONFIRM'];
const DAYS = [['Mon', '13'], ['Tue', '14'], ['Wed', '15'], ['Thu', '16'], ['Fri', '17']];
const SLOTS = ['8:30', '10:30', '11:15'];
---
<figure class="hh" data-loop="1300 2300 2500 2500 3000 4400">
  <div class="hh-stage" aria-hidden="true">
    <div class="hh-note">
      <p class="hh-note__t">How to reschedule <span>(for Mom)</span></p>
      <ol>{NOTE.map((s, i) => <li class={`hh-n hh-n${i + 1}`}><b>{i + 1}</b><span>{s}</span></li>)}</ol>
      <p class="hh-n hh-n9 hh-note__call"><span>call me if stuck</span></p>
    </div>

    <Device kind="phone" app="Willow Health" class="hh-phone">
      <div class="hh-app">
        <!-- Home: the visit as it is booked now. -->
        <div class="hh-home">
          <p class="hh-hi">Good morning, Carol</p>
          <div class="hh-visit">
            <span class="hh-visit__k">Next visit</span>
            <b>Tue, Oct 14 · 9:00 am</b>
            <span>Annual checkup · Dr. Anita Patel</span>
          </div>
          <div class="hh-tiles"><span>Appointments</span><span>Messages</span><span>Refills</span><span>Billing</span></div>
          <p class="hh-h">Reminders</p>
          <ul class="hh-list"><li>Intake form due before your visit</li><li>Flu shots are in</li></ul>
        </div>
        <!-- The visit, then a new day and time. -->
        <div class="hh-move">
          <p class="hh-back"><svg viewBox="0 0 10 10"><path d="M6.5 1.5L3 5l3.5 3.5"/></svg>Annual checkup</p>
          <div class="hh-was"><span>Booked</span><b>Tue, Oct 14 · 9:00 am</b></div>
          <div class="hh-acts"><span class="hh-act hh-act--go">Reschedule</span><span class="hh-act">Cancel</span><span class="hh-act">Directions</span></div>
          <div class="hh-pick">
            <p class="hh-h">Pick a new time</p>
            <div class="hh-days">{DAYS.map(([d, n]) => <span class={`hh-day${d === 'Thu' ? ' is-thu' : ''}`}><small>{d}</small>{n}</span>)}</div>
            <p class="hh-h hh-h--sub">Thursday morning</p>
            <div class="hh-slots">{SLOTS.map((s) => <span class={`hh-slot${s === '10:30' ? ' is-pick' : ''}`}>{s} am</span>)}</div>
          </div>
        </div>
        <!-- Done. -->
        <div class="hh-done">
          <span class="hh-tick"><svg viewBox="0 0 20 20"><path d="M5 10.5l3.2 3.2L15 7"/></svg></span>
          <b>Moved to Thursday</b>
          <span>Oct 16 · 10:30 am</span>
          <span class="hh-done__s">Same doctor, same clinic</span>
        </div>
      </div>
      <Voice slot="dock" who="person" class="sol-said out-at-5">Move my appointment to Thursday morning.</Voice>
      <Voice slot="dock" who="agent" face="/characters/ira.webp" class="r-at-4">Thursday at 10:30 with Dr. Patel. Want me to move it?</Voice>
      <Voice slot="dock" who="person" class="r-at-5">Yes, move it.</Voice>
    </Device>
  </div>
  <figcaption class="hh-cap">Example app. Carol asks once and confirms, and the app does the eight steps from her daughter's note.</figcaption>
</figure>
