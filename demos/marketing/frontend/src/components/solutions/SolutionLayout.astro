---
// The frame every solution page shares: header, the page, the footer, and the
// motion loops (motion.ts) so `data-loop` pieces play here as they do on the home page.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import '../../styles/s/solutions.css';
interface Props { title: string; description: string; id: string }
const { title, description, id } = Astro.props;
---
<Base title={`${title} | Voqalize`} description={description} mode="read">
  <Header home={false} />
  <main class={`sol sol--${id}`}>
    <slot />
  </main>
  <Footer />
  <script>import { mountMotion } from '../../scripts/motion'; mountMotion();</script>
</Base>
