---
// Scene 1, Monday: a contract manager's list of 214 agreements. On the question the app
// turns "vendor", "auto-renew" and "next 90 days" into three filters, the list drops to the
// three that match, a Notice by column appears (soonest first), and the first deadline is marked.
// Steps: 0 the list, 1 said, 2 filtered, 3 notice dates, 4 first deadline marked, 5 reply.
import Device from '../Device.astro';
import Voice from '../../Voice.astro';
interface Row { n: string; t: string; r: string; auto: boolean; notice?: string; first?: boolean }
const ROWS: Row[] = [
  { n: 'Cedar Freight', t: 'Vendor', r: 'Jan 8', auto: true, notice: 'Nov 9', first: true },
  { n: 'Brightline Media', t: 'Customer', r: 'Mar 2', auto: false },
  { n: 'Oakridge Software', t: 'Vendor', r: 'Dec 31', auto: true, notice: 'Dec 1' },
  { n: 'Pinecrest Staffing', t: 'Vendor', r: 'Apr 30', auto: true },
  { n: 'Lumen Analytics', t: 'Vendor', r: 'Jan 5', auto: true, notice: 'Dec 6' },
  { n: 'Riverside Facilities', t: 'Vendor', r: 'Nov 30', auto: false },
  { n: 'Northgate Partners', t: 'NDA', r: 'None', auto: false },
  { n: 'Summit Print', t: 'Vendor', r: 'Feb 15', auto: true },
  { n: 'Fairway Events', t: 'Customer', r: 'Jun 1', auto: true },
];
const CHIPS = ['Vendor', 'Auto-renews', 'Renews by Jan 9'];
---
<Device kind="browser" url="app.clausebook.com/agreements" app="Clausebook" class="lg-dev-rn">
  <div class="lg-rn">
    <div class="lg-rn__top">
      <b>Agreements</b>
      <span class="lg-count"><span class="lg-count__a">214 agreements</span><span class="lg-count__b">3 of 214</span></span>
    </div>
    <div class="lg-filter">
      <span class="lg-filter__ph">Search or filter</span>
      {CHIPS.map((c, j) => <span class="lg-chip" style={`--j:${j}`}>{c}</span>)}
    </div>
    <div class="lg-row lg-row--head"><span>Counterparty</span><span>Type</span><span>Renews</span><span class="lg-notice">Notice by<svg viewBox="0 0 10 10"><path d="M5 8V2M2 5l3-3 3 3"/></svg></span></div>
    {ROWS.map((r) => (
      <div class={`lg-row${r.notice ? '' : ' lg-row--out'}${r.first ? ' lg-row--first' : ''}`}>
        <span class="lg-row__n">{r.n}</span>
        <span>{r.t}</span>
        <span>{r.r}{r.auto && <small>auto</small>}</span>
        <span class="lg-notice">{r.notice}{r.first && <em class="lg-due">29 days</em>}</span>
      </div>
    ))}
  </div>
  <Fragment slot="dock">
    <Voice who="person" class="sol-said">Which of our vendor contracts auto-renew in the next 90 days?</Voice>
    <Voice who="agent" face="/characters/trisha.webp" class="r-at-5">Three of them. Cedar Freight is first, with notice due by November 9.</Voice>
  </Fragment>
</Device>
