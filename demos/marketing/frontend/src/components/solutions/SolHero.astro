---
import { CONSOLE_URL } from '../../data/env';
// Hero: words on the left, the page's motion piece on the right (slot "stage").
// The stage is where this page spends its one Voice Gradient, if it spends it at all.
interface Props { eyebrow: string; title: string; lede: string }
const { eyebrow, title, lede } = Astro.props;
---
<section class="sol-hero" aria-labelledby="sol-title" data-part="hero">
  <div class="sol-hero__text">
    <p class="sol-crumb"><a href="/">Voqalize</a> / Solutions</p>
    <p class="eyebrow">{eyebrow}</p>
    <h1 id="sol-title">{title}</h1>
    <p class="s-lede">{lede}</p>
    <div class="sol-hero__go">
      <a class="btn btn--accent" href={CONSOLE_URL} data-console rel="noopener">Go to Console</a>
      <a class="btn btn--ghost" href="/experience" target="_blank" rel="noopener">Try a live demo</a>
    </div>
    <slot name="after" />
  </div>
  <div class="sol-hero__stage"><slot name="stage" /></div>
</section>
