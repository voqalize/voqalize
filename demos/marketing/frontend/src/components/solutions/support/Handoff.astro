---
// The domain block: when the agent brings in a person, and the note that person gets.
// Left, the rules (the last one is the company's own). Right, the handoff note from
// scene 03, drawn as the card Sam sees before he says hello. Real text, not decoration:
// screen readers get the note as a list of terms.
const WHEN = [
  ['Money has to go back.', 'A refund, a credit or a dispute goes to a person.'],
  ['The customer asks for a person.', 'It connects them the first time they ask.'],
  ['The answer isn’t written down.', 'Nothing in your help center or your policies covers it.'],
  ['The customer is upset.', 'When frustration shows, a person takes over.'],
  ['Your rules say so.', 'You choose what always goes to your team.'],
];
const NOTE = [
  ['Customer', 'Dana, two bags every two weeks'],
  ['Asked', '“I think I was charged twice this month.”'],
  ['Already done', 'Found order #4471. Moved her to Thursdays. Skipped Oct 29.'],
  ['Still open', 'Refund one of two $36 charges from Oct 1'],
  ['On screen', 'Billing, charges'],
  ['Conversation', '4 minutes, transcript attached'],
];
---
<section class="sol-block sp-handoff" aria-labelledby="sp-handoff-t" data-part="handoff">
  <header class="s-head">
    <p class="eyebrow">The handoff</p>
    <h2 id="sp-handoff-t">It knows when to bring in a person.</h2>
    <p class="s-lede">Your agent answers what your help center covers and changes what your app allows. The rest goes to your team, along with everything it already did.</p>
  </header>
  <div class="sp-handoff__grid">
    <ol class="sp-when">
      {WHEN.map(([h, p]) => <li><b>{h}</b><span>{p}</span></li>)}
    </ol>
    <figure class="sp-note">
      <figcaption><span class="sp-ini">S</span>What Sam sees before he says hello</figcaption>
      <dl>
        {NOTE.map(([k, v]) => <div class={k === 'Still open' ? 'sp-note__open' : ''}><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </figure>
  </div>
</section>
