---
// Scene 03, the handoff: the billing screen (card, charges). The app finds the two charges
// for one delivery, the agent says a refund needs a person, and Sam from the billing team
// joins in the app with everything from today already in front of him.
// Steps: 0 billing, 1 said, 2 both charges marked, 3 reply, 4 Sam joins with the context, 5 Sam's first line.
import Device from '../Device.astro';
import Voice from '../../Voice.astro';
const CONTEXT = ['Order #4471, arriving Thursday', 'Two $36 charges on Oct 1', 'Thursdays now, Oct 29 skipped'];
---
<Device kind="phone" app="Morning Roast" class="sp-phone">
  <div class="sp-b">
    <p class="sp-back"><svg viewBox="0 0 10 10"><path d="M6.5 1.5L3 5l3.5 3.5" /></svg>Billing</p>
    <div class="sp-card"><span>Card ending 0118</span><b>Next charge Oct 29</b></div>
    <p class="sp-h">Charges</p>
    <ul class="sp-ch">
      <li class="sp-ch--dup" style="--j:0"><span>Plan delivery<small>Oct 1</small></span><b>$36.00</b><em>Same delivery</em></li>
      <li class="sp-ch--dup" style="--j:1"><span>Plan delivery<small>Oct 1</small></span><b>$36.00</b><em>Same delivery</em></li>
      <li><span>Plan delivery<small>Sep 17</small></span><b>$36.00</b></li>
      <li><span>Plan delivery<small>Sep 3</small></span><b>$36.00</b></li>
    </ul>
    <div class="sp-hand">
      <p class="sp-hand__who"><span class="sp-ini">S</span><span><b>Sam joined</b><small>Billing team</small></span></p>
      <p class="sp-hand__k">Already in front of Sam</p>
      <ul class="sp-ctx">{CONTEXT.map((c, j) => <li style={`--j:${j}`}>{c}</li>)}</ul>
      <p class="sp-hand__msg">Hi Dana, I see both charges. I'm refunding the second one now.</p>
    </div>
  </div>
  <Fragment slot="dock">
    <Voice who="person" class="sol-said out-at-3">And I think I was charged twice this month.</Voice>
    <Voice who="agent" face="/characters/tanya.webp" class="r-at-3 out-at-5">I see two $36 charges on October 1. Refunds go to our billing team, so I'm bringing in Sam. He'll have all of this.</Voice>
  </Fragment>
</Device>
