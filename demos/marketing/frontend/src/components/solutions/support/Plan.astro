---
// Scene 02, the change: the plan screen (cadence, delivery day, upcoming deliveries).
// Two changes in one sentence: the delivery day moves to Thursday (every date follows),
// the next delivery is skipped, the agent reads it back, and it saves on her yes.
// Steps: 0 plan, 1 said, 2 Thursday picked, 3 next one skipped, 4 read back, 5 yes and saved.
import Device from '../Device.astro';
import Voice from '../../Voice.astro';
const DAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
---
<Device kind="phone" app="Morning Roast" class="sp-phone">
  <div class="sp-p">
    <p class="sp-back"><svg viewBox="0 0 10 10"><path d="M6.5 1.5L3 5l3.5 3.5" /></svg>Your plan</p>
    <div class="sp-plan"><b>Every 2 weeks</b><span>2 bags, $36 a delivery</span></div>
    <p class="sp-h">Delivery day</p>
    <div class="sp-days">{DAYS.map((d) => <span class={`sp-day sp-day--${d.toLowerCase()}`}>{d}</span>)}</div>
    <p class="sp-h">Upcoming</p>
    <ul class="sp-up">
      <li><span>Oct 15<small>On its way</small></span></li>
      <li class="sp-up--skip"><span class="sp-swap"><i>Tue, Oct 27</i><i>Thu, Oct 29</i></span><em>Skipped</em></li>
      <li><span class="sp-swap"><i>Tue, Nov 10</i><i>Thu, Nov 12</i></span></li>
    </ul>
    <p class="sp-save"><span class="sp-save__a">Save changes</span><span class="sp-save__b">Saved</span></p>
  </div>
  <Fragment slot="dock">
    <Voice who="person" class="sol-said out-at-4">Then move me to Thursdays, and skip the next delivery.</Voice>
    <Voice who="agent" face="/characters/tanya.webp" class="r-at-4">Thursdays from now on, and the 29th is skipped. Want me to save that?</Voice>
    <Voice who="person" class="r-at-5">Yes, save it.</Voice>
  </Fragment>
</Device>
