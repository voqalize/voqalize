---
// Hero: an example coffee subscription's help center in a browser. One sentence, and the
// app skips the help article, goes four levels into settings, turns off the one toggle
// the customer named and leaves on the one she wanted kept.
// Steps: 0 help center, 1 said, 2 settings open (the path builds), 3 marketing off and
// delivery texts marked kept, 4 reply.
import Device from '../Device.astro';
import Voice from '../../Voice.astro';
const ARTICLES = [
  'Where is my order?',
  'Changing your delivery day',
  'Skipping or pausing a delivery',
  'Updating your payment method',
  'Canceling your plan',
];
// The loop lives on the wrapper: the hero's stage is not a SolScene.
const PATH = ['Account', 'Settings', 'Notifications', 'Email and texts'];
---
<div class="sp-hero" data-loop="1600 2500 1300 1700 3800">
<Device kind="browser" url="morningroast.example/help" app="Morning Roast" class="sp-desk">
  <em slot="bar" class="sp-ex">Example app</em>
  <span slot="bar" class="sp-desk__nav"><i>Shop</i><i>Plan</i><i class="is-here">Help</i></span>
  <div class="sp-desk__view">
    <div class="sp-help">
      <p class="sp-help__h">How can we help?</p>
      <p class="sp-help__search">
        <svg viewBox="0 0 12 12"><circle cx="5" cy="5" r="3.6" /><path d="M7.8 7.8L11 11" /></svg>Search 128 articles
      </p>
      <ul class="sp-help__list">
        {ARTICLES.slice(0, 2).map((a) => <li>{a}</li>)}
        <li class="sp-help__hit">Managing your email and text preferences<small>6 min read</small></li>
        {ARTICLES.slice(2).map((a) => <li>{a}</li>)}
      </ul>
    </div>
    <div class="sp-set">
      <p class="sp-path">{PATH.map((p, j) => <span style={`--j:${j}`}>{p}</span>)}</p>
      <div class="sp-group">
        <p class="sp-group__h">Email</p>
        <p class="sp-row sp-row--mkt"><span>Marketing emails<small>Offers and new roasts</small></span><i class="sp-tog is-on"></i></p>
        <p class="sp-row sp-row--rcpt"><span>Receipts</span><i class="sp-tog is-on"></i></p>
      </div>
      <div class="sp-group">
        <p class="sp-group__h">Texts</p>
        <p class="sp-row sp-row--keep"><span>Delivery texts</span><em>Kept on</em><i class="sp-tog is-on"></i></p>
        <p class="sp-row"><span>Offers by text</span><i class="sp-tog"></i></p>
      </div>
    </div>
  </div>
  <Fragment slot="dock">
    <Voice who="person" class="sol-said">Stop the marketing emails, but keep the delivery texts.</Voice>
    <Voice who="agent" face="/characters/tanya.webp" class="r-at-4">Done. Marketing emails are off, and delivery texts stay on.</Voice>
  </Fragment>
</Device>
</div>
