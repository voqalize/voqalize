---
// Scene 01, the question: the coffee app's home screen (next delivery, bags, past orders).
// On the question the app opens this week's order, reads the carrier's tracking stop by
// stop, and swaps the promised day for the real one.
// Steps: 0 home, 1 said, 2 order open, 3 tracking read, 4 new day marked, 5 reply.
import Device from '../Device.astro';
import Voice from '../../Voice.astro';
const STOPS = [
  { t: 'Packed', d: 'Fri, Oct 9' },
  { t: 'Shipped', d: 'Sat, Oct 10' },
  { t: 'Held at the Denver hub', d: 'Mon, Oct 12, storm delay' },
  { t: 'Out for delivery', d: 'Thu, Oct 15' },
];
---
<Device kind="phone" app="Morning Roast" class="sp-phone">
  <div class="sp-o">
    <div class="sp-o__home">
      <p class="sp-hi">Hi Dana</p>
      <div class="sp-next">
        <span class="sp-next__k">Your next delivery</span>
        <b class="sp-next__v">Tuesday, Oct 13</b>
        <ul class="sp-bags">
          <li><i></i>House Blend<small>2 lb, whole bean</small></li>
          <li><i></i>Ethiopia Guji<small>12 oz, ground</small></li>
        </ul>
      </div>
      <div class="sp-acts"><span><i>→</i>Track</span><span><i>↻</i>Plan</span><span><i>$</i>Billing</span><span><i>?</i>Help</span></div>
      <p class="sp-h">Past orders</p>
      <ul class="sp-list">
        <li><span>Order #4402</span><b>Sep 29</b></li>
        <li><span>Order #4339</span><b>Sep 15</b></li>
        <li><span>Order #4281</span><b>Sep 1</b></li>
      </ul>
    </div>
    <div class="sp-o__track">
      <p class="sp-back"><svg viewBox="0 0 10 10"><path d="M6.5 1.5L3 5l3.5 3.5" /></svg>Order #4471</p>
      <div class="sp-eta">
        <span>Arriving</span>
        <b><s>Tuesday, Oct 13</s><em>Thursday, Oct 15</em></b>
        <small>by 8 pm</small>
      </div>
      <p class="sp-h">Tracking</p>
      <ol class="sp-tl">
        {STOPS.map((s, j) => <li class={`sp-tl__i${j === 2 ? ' sp-tl--late' : ''}${j === 3 ? ' sp-tl--eta' : ''}`} style={`--j:${j}`}>{s.t}<small>{s.d}</small></li>)}
      </ol>
    </div>
  </div>
  <Fragment slot="dock">
    <Voice who="person" class="sol-said">Where's my order? It was supposed to come today.</Voice>
    <Voice who="agent" face="/characters/tanya.webp" class="r-at-5">It's running two days late. It'll be at your door Thursday by 8 pm.</Voice>
  </Fragment>
</Device>
