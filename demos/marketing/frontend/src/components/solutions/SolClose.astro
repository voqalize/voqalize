---
// The close: one approved tagline and one call to action (marketing/brand-kit/lines.md),
// then the other solution pages.
import { SOLUTIONS } from '../../data/solutions';
import { CONSOLE_URL } from '../../data/env';
// `go` swaps the main button so it does what the CTA says (default: the Console).
interface Props { tagline: string; cta: string; current: string; go?: { label: string; href: string } }
const { tagline, cta, current, go = { label: 'Go to Console', href: CONSOLE_URL } } = Astro.props;
---
<section class="sol-block sol-close" aria-labelledby="sol-close-t" data-part="close">
  <h2 id="sol-close-t">{tagline}</h2>
  <p class="sol-close__cta">{cta}</p>
  <div class="sol-hero__go">
    <a class="btn btn--accent" href={go.href} data-console={go.href === CONSOLE_URL ? '' : undefined} rel="noopener">{go.label}</a>
    <a class="btn btn--ghost" href="/experience" target="_blank" rel="noopener">Try a live demo</a>
    <a class="btn btn--ghost" href="/pricing">Pricing</a>
  </div>
  <nav class="sol-more" aria-label="Other solutions">
    <p>More solutions</p>
    <ul>{SOLUTIONS.filter((s) => s.slug !== current).map((s) => <li><a href={`/${s.slug}`}>{s.title}</a></li>)}</ul>
  </nav>
</section>
