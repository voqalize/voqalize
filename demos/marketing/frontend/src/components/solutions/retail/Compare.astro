---
// Scene 1, decide: the three results from the hero, in the store's phone app. On the
// question the two heated picks move into a side-by-side, the spec rows fill in, and
// the row that decides it for a truck driver ("Works in a car") is marked.
// Steps: 0 results list, 1 said, 2 side by side, 3 rows filled, 4 row and pick marked, 5 reply.
import Device from '../Device.astro';
import Voice from '../../Voice.astro';
import { ART } from './art';

const LIST = [
  { a: 'pillow', n: 'Lumbar pillow', p: '$45' },
  { a: 'wrap', n: 'Heated back wrap', p: '$89' },
  { a: 'cushion', n: 'Massage seat cushion', p: '$179' },
] as const;
// Rows of the comparison: label, heated wrap, seat cushion. `key` is the row that decides it.
const ROWS = [
  { l: 'Heat', a: 'Yes', b: 'Yes' },
  { l: 'Massage', a: 'No', b: 'Yes' },
  { l: 'Works in a car', a: 'Wall outlet', b: '12V car plug', key: true },
  { l: 'Price', a: '$89', b: '$179' },
];
---
<Device kind="phone" app="Larkfield" class="rt-dev">
  <span slot="bar" class="rt-bar__end">Back care</span>
  <div class="rt-cmp">
    <div class="rt-list">
      <p class="rt-k">3 results for your dad</p>
      {LIST.map((it, j) => (
        <div class={`rt-row rt-row--${it.a}`} style={`--j:${j}`}>
          <svg class="rt-art" viewBox="0 0 64 48" set:html={ART[it.a]} />
          <span>{it.n}</span><b>{it.p}</b>
        </div>
      ))}
    </div>
    <div class="rt-vs">
      <p class="rt-k">Compare heated picks</p>
      <div class="rt-vs__heads">
        <span></span>
        <div class="rt-vs__p"><svg class="rt-art" viewBox="0 0 64 48" set:html={ART.wrap} /><b>Heated back wrap</b></div>
        <div class="rt-vs__p rt-vs__p--pick"><svg class="rt-art" viewBox="0 0 64 48" set:html={ART.cushion} /><b>Massage seat cushion</b><em>Best for long drives</em></div>
      </div>
      {ROWS.map((r, j) => (
        <div class={`rt-vs__r${r.key ? ' rt-vs__r--key' : ''}`} style={`--j:${j}`}>
          <span>{r.l}</span><b>{r.a}</b><b>{r.b}</b>
        </div>
      ))}
    </div>
  </div>
  <Fragment slot="dock">
    <Voice who="person" class="sol-said out-at-5">Which of the heated ones is better for him? He drives a truck all day.</Voice>
    <Voice who="agent" face="/characters/tara.webp" class="r-at-5">The seat cushion. It plugs into his truck and massages while he drives.</Voice>
  </Fragment>
</Device>
