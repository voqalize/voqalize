---
// Hero: "Step 1 of 6" of an auto quote in an example insurer's app. The person says
// one sentence; each phrase gets a vermilion marker and a number (understanding),
// and the quote step with that number fills itself in (action).
// Steps: 0 step 1 open with three empty dropdowns, 1 the sentence, 2 car (2 of 6),
// 3 driving (3 of 6), 4 record (4 of 6), 5 coverage and start date (6 of 6),
// 6 the quote screen and Tess's reply.
import Device from '../Device.astro';
import Voice from '../../Voice.astro';
interface Props { reply: string }
const { reply } = Astro.props;
const ROWS = [
  { k: 'Your car', v: '2021 Toyota RAV4' },
  { k: 'Your driving', v: '12,000 miles a year' },
  { k: 'Your record', v: 'No accidents' },
  { k: 'Coverage', v: 'Full coverage' },
  { k: 'Start date', v: 'Monday' },
  { k: 'Review', v: '' },
];
const SUM = [['Car', '2021 Toyota RAV4'], ['Mileage', '12,000 a year'], ['Record', 'No accidents'], ['Starts', 'Monday']];
---
<div class="iq-stage" data-loop="1400 2100 1100 1000 900 1300 4000" aria-hidden="true">
  <Device kind="phone" app="Bayline Insurance" class="iq-phone">
    <div class="iq">
      <div class="iq-form">
        <p class="iq-h">Auto quote</p>
        <p class="iq-step">Step <span class="iq-n"><i>1</i><i>2</i><i>3</i><i>4</i><i>6</i></span> of 6</p>
        <div class="iq-bar"><i></i></div>
        <ol class="iq-rows">
          {ROWS.map((r, i) => (
            <li class={`iq-r iq-r${i + 1}`}>
              <span class="iq-num"><i>{i + 1}</i><svg viewBox="0 0 12 12"><path d="M3 6.2l2 2L9 4" /></svg></span>
              <span class="iq-k">{r.k}</span>
              {r.v && <b class="iq-v">{r.v}</b>}
              {i === 0 && (
                <span class="iq-open">
                  {[['Year', '2021'], ['Make', 'Toyota'], ['Model', 'RAV4']].map(([l, v]) => (
                    <span class="iq-sel"><small>{l}</small><em>Select</em><strong>{v}</strong><svg viewBox="0 0 10 10"><path d="M2 3.5l3 3l3-3" /></svg></span>
                  ))}
                </span>
              )}
            </li>
          ))}
        </ol>
      </div>
      <div class="iq-quote">
        <p class="iq-qh">Your quote</p>
        <div class="iq-price"><span>Full coverage, paid monthly</span><b>$112<small> a month</small></b></div>
        <ul class="iq-sum">{SUM.map(([k, v]) => <li><span>{k}</span><b>{v}</b></li>)}</ul>
        <p class="iq-buy">Review and buy</p>
      </div>
    </div>
    <Voice slot="dock" who="agent" face="/characters/tess.webp" class="r-at-6">{reply}</Voice>
  </Device>
  <div class="iq-heard sol-said">
    <p class="iq-heard__k">Said once</p>
    <Voice who="person">It's a <span class="iq-ph iq-ph1">2021 Toyota RAV4<sup>1</sup></span>, <span class="iq-ph iq-ph2">about 12,000 miles a year<sup>2</sup></span>, <span class="iq-ph iq-ph3">no accidents<sup>3</sup></span>. <span class="iq-ph iq-ph4">Full coverage<sup>4</sup></span> <span class="iq-ph iq-ph5">from Monday<sup>5</sup></span>.</Voice>
  </div>
  <p class="iq-note">Example app, driver and price</p>
</div>
