---
// Domain block: what the character does, what your team decides, and the note an adjuster
// gets when a claim is handed over (Elena's claim from the story, an example).
const DOES = [
  'Fills in quotes and claims from what people say',
  'Reads back the quote your rating system produces',
  'Reads back what their own policy says',
  'Asks for the right photos and documents',
  'Explains where a claim stands',
  'Offers repair times for the person to confirm',
];
const DECIDES = [
  'Whether a claim is covered',
  'Who was at fault',
  'Estimates, payouts and settlements',
  'Any change to a policy or a price',
];
---
<section class="sol-block ins-hand" aria-labelledby="ins-hand-t" data-part="handoff">
  <header class="s-head">
    <p class="eyebrow">The handoff</p>
    <h2 id="ins-hand-t">Your adjusters still make the call.</h2>
    <p class="s-lede">The character works from your policies and your claims system. Anything that decides coverage, fault or money goes to a person, with the whole conversation attached.</p>
  </header>
  <div class="ins-hand__grid">
    <div class="ins-hand__col">
      <h3>The character</h3>
      <ul>{DOES.map((d) => <li>{d}</li>)}</ul>
    </div>
    <figure class="ins-note">
      <figcaption>Example handoff</figcaption>
      <p class="ins-note__to"><span class="ic-who">PS</span><span>Handed to <b>Priya Shah</b><small>Claims adjuster</small></span></p>
      <dl>
        <div><dt>Claim</dt><dd>CL-4471 · Elena Ortiz · 2021 Toyota RAV4</dd></div>
        <div><dt>What happened</dt><dd>Backed into while parked. No injuries. Rear bumper.</dd></div>
        <div><dt>Evidence</dt><dd>Three photos, the other driver's plate and insurance card</dd></div>
        <div><dt>She asked</dt><dd>Is a rental covered? A body shop near work.</dd></div>
      </dl>
      <p class="ins-note__tx"><svg viewBox="0 0 14 12" aria-hidden="true"><rect x="0" y="4" width="2" height="4" rx="1" /><rect x="4" y="1" width="2" height="10" rx="1" /><rect x="8" y="3" width="2" height="6" rx="1" /><rect x="12" y="5" width="2" height="2" rx="1" /></svg>Conversation attached</p>
    </figure>
    <div class="ins-hand__col ins-hand__col--team">
      <h3>Your team</h3>
      <ul>{DECIDES.map((d) => <li>{d}</li>)}</ul>
    </div>
  </div>
</section>
