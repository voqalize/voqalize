---
// Scene 1, the accident (first notice of loss). Elena's insurance app at home: her policy
// card and four actions. On her sentence the app opens a claim draft and fills it in.
// Steps: 0 home, 1 said, 2 claim draft with today's time and place (from her phone),
// 3 what happened, injuries and damage from her words, 4 the photos her adjuster needs
// and the Send button waiting for her, 5 Tess's reply.
import Device from '../Device.astro';
import Voice from '../../Voice.astro';
interface Props { said: string; reply: string }
const { said, reply } = Astro.props;
---
<Device kind="phone" app="Bayline Insurance" class="ia-phone">
  <div class="ia">
    <div class="ia-home">
      <p class="ia-hi">Hi, Elena</p>
      <div class="ia-card">
        <span>Auto policy · Active</span>
        <b>2021 Toyota RAV4</b>
        <small>Policy LK-20931</small>
      </div>
      <div class="ia-acts">
        <span class="ia-act ia-act--claim"><svg viewBox="0 0 20 20"><path d="M5 2.5h7l3 3v12H5z M12 2.5v3h3 M8 10h5 M8 13h5" /></svg>Report a claim</span>
        <span class="ia-act"><svg viewBox="0 0 20 20"><rect x="2.5" y="5" width="15" height="10" rx="2" /><path d="M5.5 9h4 M5.5 11.5h6" /></svg>ID card</span>
        <span class="ia-act"><svg viewBox="0 0 20 20"><path d="M10 3l7.5 13h-15z M10 8v4 M10 14v.01" /></svg>Roadside help</span>
        <span class="ia-act"><svg viewBox="0 0 20 20"><rect x="2.5" y="4.5" width="15" height="11" rx="2" /><path d="M2.5 8h15" /></svg>Pay bill</span>
      </div>
      <p class="ia-sub">Open claims</p>
      <p class="ia-none">None</p>
    </div>

    <div class="ia-claim">
      <p class="ia-head"><svg viewBox="0 0 10 10"><path d="M6.5 1.5L3 5l3.5 3.5" /></svg>New claim <em>Draft</em></p>
      <div class="ia-two">
        <label class="ia-f ia-in ia-in1"><span>When</span><b>Today, 5:42 pm</b></label>
        <label class="ia-f ia-in ia-in1"><span>Injuries</span><b class="ia-late">None</b></label>
      </div>
      <label class="ia-f ia-in ia-in1"><span>Where</span><b>Green Grocer lot, 1200 Lamar Blvd</b></label>
      <div class="ia-map ia-in ia-in1">
        <svg viewBox="0 0 280 46" preserveAspectRatio="none"><path class="ia-st" d="M0 30 H280 M70 0 V46 M190 0 V46" /><path class="ia-st ia-st--minor" d="M0 12 H280 M130 0 V46 M240 0 V46" /><rect class="ia-lot" x="78" y="4" width="46" height="20" rx="2" /></svg>
        <i class="ia-pin"></i>
      </div>
      <label class="ia-f ia-in ia-in2"><span>What happened</span><b>Another car backed into mine while parked</b></label>
      <label class="ia-f ia-in ia-in2"><span>Damage</span><b>Rear bumper</b></label>
      <div class="ia-photos ia-in ia-in3">
        <p class="ia-sub">Photos for your adjuster</p>
        <div class="ia-ph">
          {['Your bumper', 'Their plate', 'Their insurance card'].map((t) => (
            <span><svg viewBox="0 0 20 20"><path d="M3 6.5h3l1.5-2h5L14 6.5h3v9H3z" /><circle cx="10" cy="11" r="2.6" /></svg>{t}</span>
          ))}
        </div>
        <p class="ia-send">Review and send</p>
      </div>
    </div>
  </div>
  <Voice slot="dock" who="person" class="sol-said out-at-5">{said}</Voice>
  <Voice slot="dock" who="agent" face="/characters/tess.webp" class="r-at-5">{reply}</Voice>
</Device>
