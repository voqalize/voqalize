---
// How it works: one spoken sentence travels left to right (jewelry store app > Voqalize >
// your brain) and comes back right to left as speech and on-screen actions. Every stage
// Voqalize handles is a small live instrument, not a list. Styles: src/styles/s/howitworks.css.
// Loop (src/scripts/motion.ts): s1 the shopper speaks, s2 Voqalize listens, s3 the brain
// decides, s4 Voqalize speaks, s5 the app acts. The last step is the complete picture.
import Voice from '../Voice.astro';

const products = [
  { name: 'Silver hoops', price: '$220', kind: 'hoop' },
  { name: 'Leaf drops', price: '$640', kind: 'drop', hit: true },
  { name: 'Pearl pendant', price: '$540', kind: 'pendant' },
  { name: 'Ruby hoops', price: '$1,240', kind: 'hoop' },
  { name: 'Jade studs', price: '$720', kind: 'stud', hit: true },
  { name: 'Gold ring', price: '$890', kind: 'ring' },
];
const filters = ['Earrings', 'Gold', 'Under $800', 'Goes with green'];
// The shopper's sentence as a waveform: noise, four spoken phrases with word breaks, noise.
const phrases = [
  [0.45, 0.8, 0.6, 0.95, 0.7],
  [0.55, 0.9, 0.65, 0.4],
  [0.5, 0.75, 0.6, 0.85],
  [0.6, 1, 0.7, 0.8, 0.5],
];
const hiss = [0.18, 0.28, 0.14, 0.22];
// The reply as synthesized audio: three phrases ("These two", "go with", "green."), drawn still.
const outPhrases = [[0.35, 0.6, 0.85, 0.6, 0.95, 0.7, 0.45], [0.4, 0.7, 0.8, 0.55, 0.65, 0.3], [0.5, 0.8, 1, 0.9, 0.7, 0.45, 0.25]];
const steps = [
  ['You speak.', 'A shopper asks the store for gold earrings under $800 that go with a green dress.'],
  ['Voqalize listens.', 'It removes the noise, hears when they have finished and turns the voice into clean text.'],
  ['Your brain decides.', 'Your backend searches its own catalog, then returns what to say and what to do.'],
  ['It speaks and acts.', 'The character says the answer while the app sets the filters.'],
];
---
<header class="s-head" data-part="head">
  <p class="eyebrow">How it works</p>
  <h2 id="t-action">One sentence, there and back.</h2>
  <p class="s-lede">Voqalize is voice AI infrastructure that sits between your app and the brain behind it.</p>
</header>

<div class="hw" data-loop="700 2300 2700 2900 2500 3600">
  <div class="hw-dia" data-part="diagram" data-part-label="The animated diagram of one sentence going through: the jewelry store app, Voqalize, and your brain.">
    <!-- 1. The app -->
    <div class="hw-col hw-col--app">
      <p class="hw-t"><b>Jewelry store app</b><span>Your app</span></p>
      <div class="hw-frame hw-app">
        <div class="hw-app__bar"><span class="hw-logo">AURUM</span><span class="hw-bag" aria-hidden="true">Bag</span></div>
        <div class="hw-search">
          <svg class="hw-search__i" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5"/><path d="M11 11l3.5 3.5"/></svg>
          <span class="hw-search__ph">Search jewelry</span>
          <span class="hw-search__q">earrings</span>
        </div>
        <div class="hw-filters">
          <span class="hw-filters__ph">All jewelry</span>
          {filters.map((f, i) => <span class={`hw-chip c${i + 1}`}>{f}</span>)}
          <span class="hw-count"><span class="hw-count__all">48 results</span><span class="hw-count__two">2 results</span></span>
        </div>
        <ul class="hw-grid" aria-label="Products">
          {products.map((p, i) => (
            <li class={`hw-item p${i + 1}${p.hit ? ' is-hit' : ''}`}>
              <svg viewBox="0 0 40 32" aria-hidden="true">
                {p.kind === 'hoop' && <><path d="M13 5v4M27 5v4"/><circle cx="13" cy="17" r="7"/><circle cx="27" cy="17" r="7"/></>}
                {p.kind === 'drop' && <><path d="M13 4v5M27 4v5"/><path d="M13 9c-5 7-5 13 0 17c5-4 5-10 0-17z"/><path d="M27 9c-5 7-5 13 0 17c5-4 5-10 0-17z"/></>}
                {p.kind === 'pendant' && <><path d="M7 4q13 22 26 0"/><circle cx="20" cy="23" r="4.5"/></>}
                {p.kind === 'stud' && <><circle cx="13" cy="16" r="5.5"/><circle cx="27" cy="16" r="5.5"/><circle class="fill" cx="13" cy="16" r="2.5"/><circle class="fill" cx="27" cy="16" r="2.5"/></>}
                {p.kind === 'ring' && <><circle cx="20" cy="20" r="8"/><path d="M16 11l4-6l4 6z"/></>}
              </svg>
              <span class="hw-item__n">{p.name}</span>
              <span class="hw-item__p">{p.price}</span>
            </li>
          ))}
        </ul>
        <div class="hw-call">
          <Voice who="person" class="hw-said">“Gold earrings under $800 that go with a green dress.”</Voice>
          <Voice who="agent" class="hw-reply">“These two go with green.”</Voice>
        </div>
      </div>
    </div>

    <!-- wire: app and Voqalize -->
    <div class="hw-wire hw-w1" aria-hidden="true">
      <div class="hw-lane hw-lane--out"><span class="hw-lab">Voice</span><span class="hw-ln"></span>
        <span class="hw-pk"><svg viewBox="0 0 14 12"><rect x="0" y="4" width="2" height="4" rx="1"/><rect x="4" y="1" width="2" height="10" rx="1"/><rect x="8" y="3" width="2" height="6" rx="1"/><rect x="12" y="5" width="2" height="2" rx="1"/></svg></span></div>
      <div class="hw-lane hw-lane--back"><span class="hw-ln"></span>
        <span class="hw-pk"><svg viewBox="0 0 14 12"><rect x="0" y="4" width="2" height="4" rx="1"/><rect x="4" y="1" width="2" height="10" rx="1"/><rect x="8" y="3" width="2" height="6" rx="1"/><rect x="12" y="5" width="2" height="2" rx="1"/></svg><span class="hw-pk__sep"></span><i>UI</i></span><span class="hw-lab">Speech and actions</span></div>
    </div>

    <!-- 2. Voqalize -->
    <div class="hw-col hw-col--vq">
      <p class="hw-t"><b><span class="hw-dot"></span>Voqalize</b><span>Voice infrastructure, in between</span></p>
      <div class="hw-frame hw-vq">
        <div class="hw-pan hw-pan--in">
          <p class="hw-pan__h">Listening</p>
          <div class="hw-wave">
            {hiss.map((h) => <i class="n" style={`--h:${h}`}></i>)}
            {phrases.map((ph, k) => (
              <>
                {ph.map((h) => <i style={`--h:${h}`}></i>)}
                {k < phrases.length - 1 ? <b class={`hw-cut k${k + 1}`}></b> : <b class="hw-end"></b>}
              </>
            ))}
            {hiss.slice(0, 3).map((h) => <i class="n" style={`--h:${h}`}></i>)}
          </div>
          <div class="hw-tags">
            <span class="hw-tag g1">Noise removed</span>
            <span class="hw-tag g2">Split into words</span>
            <span class="hw-tag g3">They finished</span>
            <span class="hw-tag g4">Speech to text</span>
          </div>
          <div class="hw-stt"><code class="hw-stt__t">gold earrings under $800 that go with a green dress</code></div>
        </div>
        <div class="hw-pan hw-pan--out">
          <p class="hw-pan__h">Speaking</p>
          <code class="hw-tts">These two go with green.</code>
          <div class="hw-wave hw-wave--out">
            {outPhrases.map((ph, k) => (
              <>
                {ph.map((h) => <i style={`--h:${h}`}></i>)}
                {k < outPhrases.length - 1 && <b class="hw-cut"></b>}
              </>
            ))}
          </div>
          <div class="hw-tags">
            <span class="hw-tag g5">Text to speech</span>
            <span class="hw-tag g6">Lips in sync</span>
          </div>
        </div>
      </div>
    </div>

    <!-- wire: Voqalize and the brain -->
    <div class="hw-wire hw-w2" aria-hidden="true">
      <div class="hw-lane hw-lane--out"><span class="hw-lab">Clean text</span><span class="hw-ln"></span><span class="hw-pk"><i>Aa</i></span></div>
      <div class="hw-lane hw-lane--back"><span class="hw-ln"></span><span class="hw-pk"><i>Say Do</i></span><span class="hw-lab">Say and Do</span></div>
    </div>

    <!-- 3. The brain -->
    <div class="hw-col hw-col--brain">
      <p class="hw-t"><b>Your brain</b><span>The jewelry store’s backend</span></p>
      <div class="hw-frame hw-brain">
        <p class="hw-host">Hosted by us, or by you</p>
        <p class="hw-idle">Waiting for the shopper <i></i><i></i><i></i></p>
        <div class="hw-rx"><span class="hw-k">Heard</span><code>“gold earrings under $800 that go with a green dress”</code></div>
        <ol class="hw-tools">
          <li class="tl1"><span class="hw-st"></span><code>catalog.search(earrings, gold, max 800)</code><span class="hw-res">14 found</span></li>
          <li class="tl2"><span class="hw-st"></span><code>style.match("green dress")</code><span class="hw-res">2 match</span></li>
          <li class="tl3"><span class="hw-st"></span><code>inventory.check(2 items)</code><span class="hw-res">in stock</span></li>
        </ol>
        <div class="hw-picks">
          <p class="hw-pick"><svg viewBox="0 0 40 32" aria-hidden="true"><path d="M13 4v5M27 4v5"/><path d="M13 9c-5 7-5 13 0 17c5-4 5-10 0-17z"/><path d="M27 9c-5 7-5 13 0 17c5-4 5-10 0-17z"/></svg><span><b>Leaf drops</b>$640</span></p>
          <p class="hw-pick"><svg viewBox="0 0 40 32" aria-hidden="true"><circle cx="13" cy="16" r="5.5"/><circle cx="27" cy="16" r="5.5"/><circle class="fill" cx="13" cy="16" r="2.5"/><circle class="fill" cx="27" cy="16" r="2.5"/></svg><span><b>Jade studs</b>$720</span></p>
        </div>
        <div class="hw-out">
          <div class="o1"><span class="hw-k">Say</span><span>“These two go with green.”</span></div>
          <div class="o2"><span class="hw-k">Do</span><code>set_filters(earrings, gold, under 800, green)</code></div>
        </div>
      </div>
    </div>
  </div>

  <ol class="hw-steps" data-part="steps" data-part-label="The four numbered steps: you speak, Voqalize listens, your brain decides, it speaks and acts.">
    {steps.map(([h, p], i) => (
      <li class={`hw-s hs${i + 1}`}>
        <button type="button" data-goto-step={i + 1} data-voice={`action.step${i + 1}`}><span class="hw-n">{i + 1}</span><b>{h}</b><span class="hw-s__p">{p}</span></button>
      </li>
    ))}
  </ol>
</div>
