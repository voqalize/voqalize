---
// Characters: why a face, then the whole cast in a still grid (Samkeet, 2026-10-11: no
// scrolling wall), every tile the same size, idling for real, and "Create yours" last.
// The loops are recorded from the avatar renderer (public/characters/loops) and play
// only on screen.
const cast = ['tanvi', 'tara', 'tushar', 'tanya', 'tess', 'trisha'];
const signals = ['Listens', 'Thinks', 'Responds'];
const name = (c: string) => c[0].toUpperCase() + c.slice(1);
---
<header class="s-head" data-part="head">
  <p class="eyebrow">Characters</p>
  <h2 id="t-cast">Every voice agent should have a face.</h2>
  <p class="s-lede">Before we hear someone’s words, we read their face. A nod or a small smile tells us we were heard. Voqalize characters give your app those same signals.</p>
</header>

<ul class="signals" data-part="signals" data-part-label="The three signals a character gives: listens, thinks, responds.">{signals.map((h) => <li>{h}</li>)}</ul>

<ul class="cast-grid" aria-label={`The cast: ${cast.map(name).join(', ')}, or your own`}>
  {cast.map((c) => (
    <li class="face-tile" data-voice={`cast.${c}`}>
      <video data-autoplay muted loop playsinline preload="none" poster={`/characters/${c}.webp`} width="280" height="300" aria-hidden="true">
        <source src={`/characters/loops/${c}.webm`} type="video/webm" />
        <source src={`/characters/loops/${c}.mp4`} type="video/mp4" />
      </video>
      <span class="face-tile__name">{name(c)}</span>
    </li>
  ))}
  <li class="face-tile face-tile--own" data-voice="cast.create_yours"><span class="face-tile__plus" aria-hidden="true">
    <!-- An empty character: the outline of a head and shoulders, with a plus to add your own. -->
    <svg class="own" viewBox="0 0 140 150">
      <circle class="own__head" cx="70" cy="62" r="26" />
      <path class="own__body" d="M22 150c2-30 22-48 48-48s46 18 48 48" />
      <circle class="own__badge" cx="104" cy="38" r="13" />
      <path class="own__plus" d="M104 31v14M97 38h14" />
    </svg>
  </span><span class="face-tile__name">Create yours</span></li>
</ul>

<p class="cast-close" data-part="close" data-part-label="The line: pick one of ours, or create your own for your brand.">Pick one of ours, or create your own for your brand.</p>
