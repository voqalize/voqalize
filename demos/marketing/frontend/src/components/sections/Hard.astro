---
// Why voice is hard to build: the team's whiteboard from the "Monday morning" film.
// The rush (about 3 s): seven pain points slam onto the board around "Your app",
// marker marks scrawl in, scribbles pile up, the estimate climbs 2 weeks, 6 weeks,
// 3 months. Then the walk: each note in turn, its reason stacking up in the panel
// (newest at the top, older ones pushed down and fading, three at most). Then the
// eraser wipes the board, "+" and the Voqalize logo go up beside the app, and the seven notes
// come back ticked: all seven, handled.
//
// Positions: x/y on the wide board (16:11), tx/ty on the tall board (Talk mode, phones).
// mark: the vermilion marker stroke drawn on the note.
const notes = [
  { h: 'When did they stop talking?', mark: 'under', x: 4, y: 7, tx: 5, ty: 5, r: -2,
    p: 'A pause can be a full stop or someone thinking. Answer too early and you cut them off. Too late and it feels broken.' },
  { h: 'They cut in.', mark: 'ring', x: 42, y: 9, tx: 60, ty: 8, r: 2,
    p: 'People interrupt. The voice has to stop on the word, and the agent has to know what was actually heard.' },
  { h: 'Under a second.', mark: 'double', x: 72, y: 7, tx: 57, ty: 25, r: -1.5,
    p: 'In conversation, people take turns with gaps of about 200 milliseconds, across the ten languages studied (PNAS, 2009). Every step from the microphone to the reply has to fit.' },
  { h: 'Noise and echo.', mark: 'zig', x: 5, y: 38, tx: 5, ty: 27, r: 1.5,
    p: 'A television, traffic, a dog, and the agent’s own voice coming back through the speaker. Only the person should get through.' },
  { h: 'Accents and languages.', mark: 'arrow', x: 72, y: 39, tx: 56, ty: 72, r: -1,
    p: 'Names, numbers, addresses, sometimes two languages in one sentence. All of it has to land as the right text.' },
  { h: 'Browsers and networks.', mark: 'ring', x: 6, y: 67, tx: 6, ty: 72, r: 2,
    p: 'Microphones, WebRTC, Safari and a weak connection on a train. The audio has to arrive anyway.' },
  { h: 'A voice and a face.', mark: 'under', x: 70, y: 68, tx: 30, ty: 85, r: -2,
    p: 'Speech that starts while the reply is still being written, and lips that match it.' },
];
// The small stuff the team scrawls in between (muted, never read closely).
const bits = [
  { t: 'VAD', x: 39, y: 25, tx: 40, ty: 35, r: -6 },
  { t: 'barge-in', x: 55, y: 24, tx: 64, ty: 36, r: 5 },
  { t: 'jitter', x: 22, y: 57, tx: 8, ty: 56, r: 4 },
  { t: 'codecs', x: 50, y: 63, tx: 70, ty: 57, r: -4 },
  { t: 'TURN servers', x: 6, y: 25, tx: 8, ty: 18, r: 3 },
  { t: 'Safari??', x: 88, y: 26, tx: 72, ty: 18, r: 8 },
  { t: 'voices?', x: 30, y: 81, tx: 8, ty: 64, r: -5 },
  { t: 'retries', x: 86, y: 56, tx: 72, ty: 61, r: -3 },
  { t: 'lip sync', x: 58, y: 80, tx: 40, ty: 64, r: 6 },
  { t: 'servers?', x: 21, y: 47, tx: 6, ty: 41, r: -7, sticky: true },
];
const marks: Record<string, string> = {
  under: 'M2 7 C 30 3, 60 9, 98 4',
  double: 'M2 5 C 35 2, 65 7, 98 3 M6 9 C 40 6, 70 10, 96 7',
  ring: 'M50 2 C 88 1, 99 10, 96 18 C 92 26, 30 27, 8 22 C -3 18, 2 6, 22 3 C 32 2, 44 1, 56 3',
  zig: 'M2 6 L 12 2 L 22 8 L 32 2 L 42 8 L 52 2 L 62 8 L 72 2 L 82 8 L 92 3',
  arrow: 'M98 4 C 70 10, 40 10, 4 6 M14 1 L 3 6 L 13 11',
};
// Charcoal arrows into the app box (wide board only), in a 160 x 110 box that matches it.
const arrows = [
  { d: 'M38 22 C 46 28, 50 34, 57 41 M51 40 L 57 41 L 56 35', t: 0.3 },
  { d: 'M80 18 C 77 26, 82 32, 80 40 M76 35 L 80 40 L 84 35', t: 0.6 },
  { d: 'M120 19 C 114 30, 108 34, 102 41 M103 35 L 102 41 L 108 40', t: 0.9 },
  { d: 'M46 47 C 50 46, 53 48, 57 49 M52 46 L 57 49 L 52 52', t: 1.2 },
  { d: 'M55 74 C 60 70, 62 66, 66 60 M61 62 L 66 60 L 67 66', t: 1.8 },
  { d: 'M112 74 C 106 70, 101 66, 97 60 M96 66 L 97 60 L 102 62', t: 2.1 },
];
// Step 0 start, 1 the rush, 2 to 8 one note each, 9 the eraser, 10 the answer and the hold.
const loop = ['500', '3400', ...notes.map(() => '3600'), '1900', '7000'].join(' ');
const pos = (o: { x: number; y: number; tx: number; ty: number; r: number }, i: number, d: number) =>
  `--x:${o.x}%;--y:${o.y}%;--tx:${o.tx}%;--ty:${o.ty}%;--r:${o.r}deg;--d:${d}s;--w:${(o.x / 100 * 0.9 + (o.y / 100) * 0.25).toFixed(2)}s;--i:${i}`;
---
<header class="s-head" data-part="head">
  <p class="eyebrow">Why voice is hard to build</p>
  <h2 id="t-handled">The hard part of voice is listening.</h2>
  <p class="s-lede">Put a voice on an app you already have, and this is the list your team writes on the whiteboard.</p>
</header>

<div class="hb" data-loop={loop}>
  <div class="hb__board" aria-hidden="true" data-part="board" data-part-label="The whiteboard animation: the seven hard problems a team lists, and its estimate growing from 2 weeks to 3 months.">
    <div class="hb__agent"><span class="hb__box">Your app</span><span class="hb__done"><span class="hb__plus">+</span><img class="logo-on-light" src="/brand/logo-light.png" alt="Voqalize" width="96" height="32" /><img class="logo-on-dark" src="/brand/logo-dark.png" alt="" width="96" height="32" /></span><span class="hb__all">All seven, handled.</span></div>
    <svg class="hb__arrows" viewBox="0 0 160 110" preserveAspectRatio="none">
      {arrows.map((a) => <path pathLength="1" d={a.d} style={`--d:${a.t}s`} />)}
    </svg>
    {bits.map((b, i) => (
      <span class={`hb__bit${b.sticky ? ' hb__bit--sticky' : ''}`} style={pos(b, i, 0.25 + i * 0.2)}>{b.t}</span>
    ))}
    {notes.map((n, i) => (
      <p class={`hb__note hn${i + 1} m-${n.mark}`} style={pos(n, i, 0.08 + i * 0.3)}>
        <i class="hb__tick"></i><span>{n.h}</span>
        <svg viewBox={n.mark === 'ring' ? '0 0 100 28' : '0 0 100 12'} preserveAspectRatio="none"><path pathLength="1" d={marks[n.mark]} /></svg>
      </p>
    ))}
    <p class="hb__est">
      <span class="hb__k">Team’s estimate</span>
      <span class="ev e1">2 weeks<i></i></span>
      <span class="ev e2">6 weeks<i></i></span>
      <span class="ev e3">3 months<svg viewBox="0 0 100 28" preserveAspectRatio="none"><path pathLength="1" d={marks.ring} /></svg></span>
    </p>
    <span class="hb__eraser"></span>
  </div>
  <div class="hb__side" data-part="why" data-part-label="Why each one is hard: the seven problems explained, ending with: add Voqalize and all seven are handled.">
    <p class="hb__why-k">Why each one is hard</p>
    <ol class="hb__why">
      {notes.map((n, i) => <li class={`hy hy${i + 1}`}><div><b>{n.h}</b><span>{n.p}</span></div></li>)}
      <li class="hy hy8 hy--end"><div><b>Add Voqalize and all seven are handled.</b><span>Your team keeps building the app. We take care of the listening.</span></div></li>
    </ol>
  </div>
</div>
<p class="try-live" data-part="try" data-part-label="The line: try it now, interrupt me while I am talking.">Try it now. Interrupt me while I am talking.</p>
