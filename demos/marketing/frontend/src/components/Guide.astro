---
// Talk mode's left column: Tanvi, her controls, the ribbon, live captions, and things to say.
// Only the two call controls are clickable during a conversation: the visitor speaks.
import { OPENING_LINES } from '../data/lines';
const headline = OPENING_LINES[0].split(' ');
const verbs = ['Sees', 'Listens', 'Understands', 'Acts'];
---
<section class="guide" aria-label="Talk to Tanvi">
  <div class="face" id="face">
    <img src="/characters/tanvi.webp" alt="Tanvi, a Voqalize character" width="256" height="256" />
    <div class="face__live" id="face-live" aria-hidden="true"></div>
  </div>
  <audio id="voice-audio" autoplay hidden></audio>
  <div class="who">
    <button type="button" class="callctl callctl--end" data-hang aria-label="End the conversation">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3.6 14.4c-.5-.5-.6-1.3-.1-1.9 4.6-4.7 12.4-4.7 17 0 .5.6.4 1.4-.1 1.9l-1.6 1.5c-.5.5-1.2.5-1.7.2l-2-1.3c-.4-.3-.6-.7-.6-1.2v-1.5a10 10 0 0 0-5 0v1.5c0 .5-.2.9-.6 1.2l-2 1.3c-.5.3-1.2.3-1.7-.2z" fill="currentColor"/></svg>
      <span>End</span>
    </button>
    <span class="who__name"><span class="who__dot" aria-hidden="true"></span>Tanvi</span>
    <button type="button" class="callctl callctl--mute" id="mute" aria-pressed="false" aria-label="Mute your microphone">
      <svg class="ic-on" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <svg class="ic-off" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M4 4l16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <span class="lbl">Mute</span>
    </button>
  </div>
  <canvas class="ribbon" id="ribbon" aria-hidden="true"></canvas>
  <p class="caption intro" id="caption" aria-live="polite">{headline.map((w, i) => <Fragment><span class="iw" style={`--i:${i}`}>{w}</span> </Fragment>)}</p>
  <script is:inline define:vars={{ lines: OPENING_LINES }}>
    // The same opening line as the Read hero, picked once per visit.
    window.__vqLine = window.__vqLine || lines[Math.floor(Math.random() * lines.length)];
    document.getElementById('caption').innerHTML = window.__vqLine.split(' ').map((w, i) => `<span class="iw" style="--i:${i}">${w}</span> `).join('');
  </script>
  <p class="descriptor">
    <span class="descriptor__lead">Give your software a voice that</span>
    <span class="descriptor__verbs">{verbs.map((v, i) => <Fragment><span class="verb" style={`--v:${i}`}>{v}</span>{i < 2 ? ', ' : i === 2 ? <span class="and"> and </span> : '.'}</Fragment>)}</span>
  </p>
  <div class="hero-actions">
    <button type="button" class="btn" data-talk>Talk to Tanvi</button>
    <button type="button" class="btn btn--ghost" data-set-mode="read">Read the story</button>
  </div>
  <p class="hero-note" id="hero-note" role="status"></p>
  <p class="you" id="you"></p>
  <!-- A page outside this one that Tanvi hands over ("the docs are below me"): a link to click,
       because a browser blocks a tab opened with no click behind it. -->
  <a class="linkcard" id="linkcard" href="https://docs.voqalize.com" target="_blank" rel="noopener" hidden>
    <span class="linkcard__label">Voqalize docs</span><span class="linkcard__url">docs.voqalize.com</span>
    <svg class="linkcard__go" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
  <div class="hints" id="hints-wrap">
    <p class="hints__label">You could say</p>
    <ul class="hints__list" id="hints"></ul>
  </div>
  <p class="saved" aria-live="off">Clicks you didn't make <b id="saved">0</b></p>
</section>
