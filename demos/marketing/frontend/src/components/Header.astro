---
import { SECTIONS } from '../data/sections';
import { CONSOLE_URL } from '../data/env';
interface Props { home?: boolean }
const { home = true } = Astro.props;
// The bar's section links (Samkeet, round 4). The hard part is not in it; every section is still on the page.
const known = new Set(SECTIONS.map((s) => s.id));
const NAV = ([['shift', 'Why voice, why now'], ['action', 'How it works'], ['ways', 'Getting started'], ['worlds', 'Use cases'], ['cast', 'Characters'], ['pricing', 'Pricing']] as const).filter(([id]) => known.has(id));
---
<header class="top">
  <a class="top__logo" href="/" aria-label="Voqalize home"><img class="logo-on-light" src="/brand/logo-light.png" alt="Voqalize" width="117" height="39" /><img class="logo-on-dark" src="/brand/logo-dark.png" alt="" width="117" height="39" /></a>
  {home && (
    <nav class="top__nav" aria-label="Sections">
      {NAV.map(([id, label]) => <a href={`#s-${id}`} data-goto={id}>{label}</a>)}
    </nav>
  )}
  <span class="top__spacer"></span>
  {home && (
    <div class="mode" role="group" aria-label="How to explore">
      <button type="button" data-set-mode="talk" aria-pressed="true">Talk</button>
      <button type="button" data-set-mode="read" aria-pressed="false">Read</button>
    </div>
  )}
  <button type="button" class="theme-btn" id="theme-btn" aria-label="Switch between light and dark">
    <svg class="theme-btn__moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    <svg class="theme-btn__sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
  </button>
  <script is:inline>
    // Light or dark, remembered like the "dark mode" voice command (vq-theme).
    document.getElementById('theme-btn').addEventListener('click', function () {
      var r = document.documentElement;
      var dark = r.dataset.theme ? r.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      r.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('vq-theme', r.dataset.theme); } catch (e) {}
    });
  </script>
  <a class="btn btn--sm top__cta" href="/experience" target="_blank" rel="noopener">Experience Center</a>
  <a class="btn btn--sm btn--accent top__console" href={CONSOLE_URL} data-console rel="noopener"><span class="top__long">Go to&nbsp;</span>Console</a>
</header>
