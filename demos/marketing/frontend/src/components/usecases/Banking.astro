---
// Banking: the home screen (balance card, accounts, recent activity). On the question
// the app slides to a car loan view, works out the loan and ranks the offers.
// Steps: 0 home, 1 said, 2 loan worked out, 3 offers ranked, 4 cheapest marked, 5 reply.
const OFFERS = [
  { n: 'Lakeside Credit Union', r: '5.9% APR', m: '$347/mo' },
  { n: 'Northline Bank', r: '6.8% APR', m: '$355/mo' },
  { n: 'Dealer financing', r: '7.9% APR', m: '$364/mo' },
];
---
<div class="bk">
  <div class="bk-home">
    <p class="bk-hi">Good morning, Maya</p>
    <div class="bk-card">
      <span class="bk-card__k">Checking ··· 4521</span>
      <b class="bk-card__v">$12,400</b>
      <svg class="bk-spark" viewBox="0 0 120 30" preserveAspectRatio="none"><path d="M0 24 L14 20 L26 22 L40 14 L54 17 L68 10 L82 13 L96 6 L108 9 L120 4"/><circle cx="120" cy="4" r="2.6"/></svg>
    </div>
    <div class="bk-acts"><span><i>+</i>Move</span><span><i>$</i>Pay</span><span><i>%</i>Loans</span><span><i>…</i>More</span></div>
    <p class="bk-h">Accounts</p>
    <ul class="bk-list">
      <li><span>Savings</span><b>$8,200</b></li>
      <li><span>Credit card</span><b>−$640</b></li>
    </ul>
    <p class="bk-h">Recent</p>
    <ul class="bk-list bk-list--tx">
      <li><span>Green Grocer</span><b>−$84.20</b></li>
      <li><span>Payroll</span><b>+$3,100</b></li>
      <li><span>Corner Coffee</span><b>−$4.50</b></li>
    </ul>
  </div>
  <div class="bk-loan">
    <p class="bk-back"><svg viewBox="0 0 10 10"><path d="M6.5 1.5L3 5l3.5 3.5"/></svg>Car loan</p>
    <div class="bk-calc">
      <p><span>Car price</span><b>$26,000</b></p>
      <p><span>You can put down</span><b>−$8,000</b></p>
      <p class="bk-calc__note">Balance, less two months of costs</p>
      <p class="bk-calc__total"><span>Loan needed</span><b class="bk-num">$<i></i>,000</b></p>
    </div>
    <p class="bk-h">Offers, cheapest first</p>
    <ol class="bk-offers">
      {OFFERS.map((o, j) => (
        <li class={`bk-o bk-o${j + 1}`} style={`--j:${j}`}><span class="bk-o__n">{o.n}<small>{o.r}</small></span><b>{o.m}</b>{j === 0 && <em>Cheapest</em>}</li>
      ))}
    </ol>
  </div>
</div>
