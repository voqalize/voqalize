---
// Jewelry store: a two-column shop grid that scrolls on its own. On the sentence it
// narrows to the two gold pairs that go with green, marked in vermilion.
// Steps: 0 browsing, 1 said, 2 narrowed, 3 marked, 4 reply.
const G = 'fill="none" stroke="#C99A3A" stroke-width="3.2" stroke-linecap="round"';
const S = 'fill="none" stroke="#9AA1AB" stroke-width="3.2" stroke-linecap="round"';
const pearls = Array.from({ length: 13 }, (_, k) => {
  const a = Math.PI * (0.08 + 0.84 * (k / 12));
  return `<circle cx="${(32 - 22 * Math.cos(a)).toFixed(1)}" cy="${(10 + 26 * Math.sin(a)).toFixed(1)}" r="2.9" fill="#F7F1E4" stroke="#C9BFA8" stroke-width=".9"/>`;
}).join('');
const ART: Record<string, string> = {
  hoops: `<circle cx="21" cy="12" r="2.2" fill="#C99A3A"/><circle cx="43" cy="12" r="2.2" fill="#C99A3A"/><circle cx="21" cy="26" r="11" ${G}/><circle cx="43" cy="26" r="11" ${G}/><path d="M14 20a9 9 0 0 1 6-5" stroke="#F2D88B" stroke-width="1.4" fill="none" stroke-linecap="round"/><path d="M36 20a9 9 0 0 1 6-5" stroke="#F2D88B" stroke-width="1.4" fill="none" stroke-linecap="round"/>`,
  leaf: `<circle cx="21" cy="10" r="2.2" fill="#C99A3A"/><circle cx="43" cy="10" r="2.2" fill="#C99A3A"/><path d="M21 12v5M43 12v5" stroke="#C99A3A" stroke-width="1.4"/><path d="M21 17c-7 8-6 17 0 21c6-4 7-13 0-21z" fill="#D9AE4E" stroke="#B48A2C" stroke-width="1"/><path d="M43 17c-7 8-6 17 0 21c6-4 7-13 0-21z" fill="#D9AE4E" stroke="#B48A2C" stroke-width="1"/><path d="M21 20v15M43 20v15" stroke="#F2D88B" stroke-width="1"/>`,
  ring: `<ellipse cx="32" cy="30" rx="12" ry="10" ${S}/><path d="M27 18l5-7l5 7l-5 4z" fill="#E9EEF3" stroke="#9AA1AB" stroke-width="1"/>`,
  pearls: pearls,
  studs: `<path d="M21 18l5 6l-5 6l-5-6z" fill="#E9EEF3" stroke="#9AA1AB" stroke-width="1.2"/><path d="M43 18l5 6l-5 6l-5-6z" fill="#E9EEF3" stroke="#9AA1AB" stroke-width="1.2"/><path d="M50 14v4M48 16h4" stroke="#9AA1AB" stroke-width="1" stroke-linecap="round"/>`,
  pendant: `<path d="M12 6c4 14 12 20 20 22c8-2 16-8 20-22" fill="none" stroke="#C99A3A" stroke-width="1.6" stroke-dasharray="2 1.6"/><path d="M32 28c-5 5-5 11 0 14c5-3 5-9 0-14z" fill="#D9AE4E" stroke="#B48A2C" stroke-width="1"/>`,
  gold: `<ellipse cx="32" cy="30" rx="12" ry="10" ${G}/><circle cx="32" cy="18" r="4.4" fill="#F4F1EA" stroke="#C99A3A" stroke-width="1.6"/>`,
  bangle: `<ellipse cx="32" cy="26" rx="20" ry="9" fill="none" stroke="#9AA1AB" stroke-width="4.4"/><ellipse cx="32" cy="26" rx="20" ry="9" fill="none" stroke="#E4E7EB" stroke-width="1.2" stroke-dasharray="10 30"/>`,
};
const FEED = [
  { a: 'hoops', n: 'Gold hoops', p: '$640' },
  { a: 'pearls', n: 'Pearl strand', p: '$950' },
  { a: 'ring', n: 'Silver solitaire', p: '$180' },
  { a: 'leaf', n: 'Gold leaf drops', p: '$720' },
  { a: 'pendant', n: 'Gold pendant', p: '$1,200' },
  { a: 'studs', n: 'Silver studs', p: '$120' },
  { a: 'bangle', n: 'Silver bangle', p: '$260' },
  { a: 'gold', n: 'Gold ring', p: '$890' },
];
const MATCH = [FEED[0], FEED[3]];
---
<div class="jw">
  <div class="jw-search"><svg viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5L14 14"/></svg><span class="jw-search__ph">Search jewelry</span><span class="jw-search__q">Gold earrings, under $800, green dress</span></div>
  <div class="jw-feed">
    <div class="jw-track">
      {[...FEED, ...FEED].map((f) => (
        <div class="jw-card"><svg class="jw-art" viewBox="0 0 64 48" set:html={ART[f.a]} /><span>{f.n}</span><b>{f.p}</b></div>
      ))}
    </div>
  </div>
  <div class="jw-results">
    <div class="jw-chips"><span>Earrings</span><span>Gold</span><span>Under $800</span><span>Green dress</span></div>
    <p class="jw-count">2 of 214 pieces</p>
    <div class="jw-pair">
      {MATCH.map((f) => (
        <div class="jw-card jw-card--hit"><svg class="jw-art" viewBox="0 0 64 48" set:html={ART[f.a]} /><span>{f.n}</span><b>{f.p}</b><em><i></i>Goes with green</em></div>
      ))}
    </div>
  </div>
</div>
