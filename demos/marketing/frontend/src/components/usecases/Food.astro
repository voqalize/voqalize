---
// Food delivery: a two-column menu grid that scrolls on its own. On the sentence it
// opens Friday's pizza, switches the size to Large and takes the olives off the pie.
// Steps: 0 browsing, 1 said, 2 pizza open, 3 large, 4 no olives, 5 ready to place, 6 reply.
const pizzaSmall = `<circle cx="32" cy="25" r="18" fill="#E2B66B"/><circle cx="32" cy="25" r="15" fill="#D9563E"/><circle cx="26" cy="20" r="4" fill="#F5DFA0"/><circle cx="37" cy="28" r="4.4" fill="#F5DFA0"/><circle cx="29" cy="31" r="2" fill="#2B2620"/><circle cx="38" cy="19" r="2" fill="#2B2620"/><ellipse cx="34" cy="22" rx="3" ry="1.6" fill="#4C8B4A"/>`;
const FOOD: Record<string, string> = {
  pizza: pizzaSmall,
  burger: `<path d="M16 22a16 11 0 0 1 32 0z" fill="#D9A55B"/><rect x="15" y="23" width="34" height="4" rx="2" fill="#4C8B4A"/><rect x="16" y="27" width="32" height="5" rx="2.5" fill="#6B3E2A"/><path d="M16 33h32a4 4 0 0 1-4 5H20a4 4 0 0 1-4-5z" fill="#D9A55B"/><circle cx="26" cy="15" r=".9" fill="#F7EBD0"/><circle cx="33" cy="13" r=".9" fill="#F7EBD0"/><circle cx="39" cy="16" r=".9" fill="#F7EBD0"/>`,
  sushi: `<g><circle cx="22" cy="25" r="10" fill="#2B2F2A"/><circle cx="22" cy="25" r="7" fill="#F7F3EA"/><circle cx="22" cy="25" r="3" fill="#E8835A"/></g><g><circle cx="43" cy="25" r="10" fill="#2B2F2A"/><circle cx="43" cy="25" r="7" fill="#F7F3EA"/><circle cx="43" cy="25" r="3" fill="#7DB36A"/></g>`,
  salad: `<path d="M12 22h40a20 16 0 0 1-40 0z" fill="#E9E4DA"/><circle cx="22" cy="20" r="6" fill="#6FA35A"/><circle cx="32" cy="17" r="7" fill="#4C8B4A"/><circle cx="42" cy="20" r="6" fill="#7DB36A"/><circle cx="27" cy="22" r="2.6" fill="#D9563E"/><circle cx="38" cy="23" r="2.6" fill="#D9563E"/>`,
  tacos: `<path d="M10 34a14 14 0 0 1 28 0z" fill="#E7C177"/><path d="M13 30c3-5 8-7 11-6c3-1 8 1 11 6" fill="none" stroke="#4C8B4A" stroke-width="3" stroke-linecap="round"/><path d="M28 36a14 14 0 0 1 28 0z" fill="#DDB467"/><path d="M31 32c3-5 8-7 11-6c3-1 8 1 11 6" fill="none" stroke="#D9563E" stroke-width="3" stroke-linecap="round"/>`,
  ramen: `<path d="M12 22h40a20 17 0 0 1-40 0z" fill="#2B2F2A"/><ellipse cx="32" cy="22" rx="20" ry="4" fill="#E8C37A"/><circle cx="26" cy="21" r="3" fill="#F7F3EA"/><circle cx="26" cy="21" r="1.4" fill="#E8A13A"/><path d="M36 6l4 18M42 6l2 18" stroke="#B48A5A" stroke-width="1.6" stroke-linecap="round"/>`,
  donut: `<circle cx="32" cy="25" r="15" fill="#D9A55B"/><path d="M18 22a14 13 0 0 1 28 0c0 4-2 4-4 6c-3 3-5 0-8 2c-3 2-6 1-8-1c-3-3-8 0-8-7z" fill="#F2A3B0"/><circle cx="32" cy="25" r="5" fill="var(--bg)"/><path d="M24 17l2 1M38 16l-1 2M41 24l2 0M27 29l1 2" stroke="#FFF7E0" stroke-width="1.4" stroke-linecap="round"/>`,
  curry: `<ellipse cx="32" cy="27" rx="21" ry="11" fill="#E9E4DA"/><ellipse cx="25" cy="26" rx="11" ry="7" fill="#F7F3EA"/><ellipse cx="38" cy="27" rx="11" ry="7" fill="#D88A36"/><circle cx="36" cy="25" r="1.6" fill="#4C8B4A"/><circle cx="41" cy="28" r="1.4" fill="#4C8B4A"/>`,
};
const FEED = [
  { a: 'pizza', n: 'Margherita', p: '$14', tag: 'Friday' },
  { a: 'burger', n: 'Smash burger', p: '$12' },
  { a: 'sushi', n: 'Maki set', p: '$16' },
  { a: 'salad', n: 'Garden bowl', p: '$11' },
  { a: 'ramen', n: 'Tonkotsu ramen', p: '$15' },
  { a: 'tacos', n: 'Street tacos', p: '$10' },
  { a: 'curry', n: 'Butter chicken', p: '$15' },
  { a: 'donut', n: 'Glazed donuts', p: '$6' },
];
const OLIVES = [[34, 40], [62, 34], [78, 58], [50, 74], [30, 62], [66, 82]];
const CHEESE = [[44, 46, 9], [68, 48, 8], [38, 70, 8], [60, 70, 10], [52, 30, 7], [78, 72, 6]];
---
<div class="fd">
  <div class="fd-feed">
    <p class="fd-h">Order again</p>
    <div class="fd-track">
      {[...FEED, ...FEED].map((f) => (
        <div class="fd-card"><svg viewBox="0 0 64 48" set:html={FOOD[f.a]} />{f.tag && <small>{f.tag}</small>}<span>{f.n}</span><b>{f.p}</b></div>
      ))}
    </div>
  </div>
  <div class="fd-item">
    <div class="fd-top">
      <svg class="fd-pizza" viewBox="0 0 112 112">
        <circle cx="56" cy="56" r="52" fill="#E2B66B"/>
        <circle cx="56" cy="56" r="44" fill="#D9563E"/>
        {CHEESE.map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill="#F5DFA0" />)}
        <ellipse cx="48" cy="56" rx="6" ry="3" fill="#4C8B4A" transform="rotate(-30 48 56)" />
        <ellipse cx="72" cy="40" rx="6" ry="3" fill="#4C8B4A" transform="rotate(20 72 40)" />
        {OLIVES.map(([x, y], k) => <g class="fd-olive" style={`--k:${k};transform-origin:${x}px ${y}px`}><circle cx={x} cy={y} r="4.6" fill="#2B2620" /><circle cx={x} cy={y} r="1.7" fill="#D9563E" /></g>)}
      </svg>
      <div class="fd-name"><small>Ordered Friday</small><b>Margherita</b><span class="fd-price"><i>$14</i><i>$18</i></span></div>
    </div>
    <div class="fd-size"><i class="fd-size__k"></i><span>Small</span><span>Medium</span><span>Large</span></div>
    <ul class="fd-tops">
      <li><span>Basil</span><i class="fd-tick"></i></li>
      <li class="fd-tops__olive"><span>Olives</span><i class="fd-tick"></i></li>
      <li><span>Extra cheese</span><i class="fd-tick fd-tick--off"></i></li>
    </ul>
    <p class="fd-addr"><span>Deliver to</span><b>Same address, 14 Elm St</b></p>
    <p class="fd-place">Place order · $18</p>
  </div>
</div>
