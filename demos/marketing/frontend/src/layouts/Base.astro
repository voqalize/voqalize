---
import '../styles/global.css';
import '../styles/sections.css';
import '../styles/voices.css';
import '../styles/s/howitworks.css';
import '../styles/s/hard.css';
import '../styles/s/usecases.css';
import CookieConsent from '../components/CookieConsent.astro';
interface Props { title?: string; description?: string; mode?: 'talk' | 'read' }
const {
  title = 'Voqalize: Your customers talk. Your app acts.',
  description = 'Voqalize is voice AI infrastructure. Give your software a voice that sees, listens, understands and acts.',
  mode = 'talk',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Console links follow the host: voqalize.com -> prod console; localhost and *.dev.voqalize.com -> dev (src/data/env.ts).
      document.addEventListener('DOMContentLoaded', function () {
        var h = location.hostname, url = null;
        if (h === 'voqalize.com' || h === 'www.voqalize.com') url = 'https://app.voqalize.com';
        else if (h === 'localhost' || h === '127.0.0.1' || /(^|\.)dev\.voqalize\.com$/.test(h)) url = 'https://app.dev.voqalize.com';
        if (url) document.querySelectorAll('a[data-console]').forEach(function (a) { a.href = url; });
      });
    </script>
    <script is:inline>
      // Google Consent Mode: everything denied until the visitor chooses (src/scripts/consent.ts
      // sends the update). Must run before any Google tag is added to the page.
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', wait_for_update: 500 });
      try { var c = JSON.parse(localStorage.getItem('vq-consent') || 'null'); if (c && c.v === 1) { var g = function (on) { return on ? 'granted' : 'denied'; }; window.gtag('consent', 'update', { analytics_storage: g(c.analytics), ad_storage: g(c.ads), ad_user_data: g(c.ads), ad_personalization: g(c.ads) }); } } catch (e) {}
    </script>
    <script is:inline>
      // Shown beside Tanvi in Talk mode (?frame=1): the page alone, no header, footer or dock of its own.
      if (new URLSearchParams(location.search).get('frame') === '1') document.documentElement.classList.add('is-framed');
    </script>
    <script is:inline>try { var t = localStorage.getItem('vq-theme'); if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t; } catch (e) {}</script>
  </head>
  <body data-mode={mode}>
    <slot />
    <CookieConsent />
    <script>import '../scripts/analytics';</script>
  </body>
</html>
