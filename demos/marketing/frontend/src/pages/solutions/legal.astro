---
// Legal: one vendor contract across one week, told in three apps that listen (renewal list,
// redline, signature), after a hero in a law firm's client portal. Notes, copy and decisions:
// docs/sections/solutions-legal.md. Pieces: src/components/solutions/legal/. Styles: src/styles/solutions/legal.css.
import SolutionLayout from '../../components/solutions/SolutionLayout.astro';
import SolHero from '../../components/solutions/SolHero.astro';
import SolScene from '../../components/solutions/SolScene.astro';
import SolFit from '../../components/solutions/SolFit.astro';
import SolClose from '../../components/solutions/SolClose.astro';
import HeroReader from '../../components/solutions/legal/HeroReader.astro';
import Renewals from '../../components/solutions/legal/Renewals.astro';
import Redline from '../../components/solutions/legal/Redline.astro';
import Signing from '../../components/solutions/legal/Signing.astro';
import Handoff from '../../components/solutions/legal/Handoff.astro';
import '../../styles/solutions/legal.css';
---
<SolutionLayout id="legal" title="Legal" description="Voqalize for legal apps: people ask a contract a question out loud, and your app turns to the clause, marks it and explains what it says. The advice stays with the lawyers.">
  <SolHero
    eyebrow="Legal"
    title="Let your customers ask the contract."
    lede="The answer someone needs is usually one clause on one page of forty. With Voqalize they ask out loud, and your app turns to the clause, marks it and explains what it says. The legal advice stays with the lawyers."
  >
    <HeroReader slot="stage" />
  </SolHero>

  <section class="sol-story" aria-labelledby="lg-story-t">
    <header class="s-head">
      <p class="eyebrow">One contract, one week</p>
      <h2 id="lg-story-t">A renewal alert on Monday, a signature on Friday.</h2>
      <p class="s-lede">Rachel runs legal at a mid-size company. Here is one vendor contract moving through her week, in a contract manager and a signing app that both listen. The apps, names and numbers are examples.</p>
    </header>

    <SolScene
      n={1}
      kicker="Monday · the renewal list"
      title="Catch the contract before it renews on its own."
      said="Which of our vendor contracts auto-renew in the next 90 days?"
      beats={[
        'Hears “vendor”, “auto-renew” and “next 90 days”',
        'Narrows 214 agreements to the three that match',
        'Adds each notice deadline, soonest first',
        'Marks Cedar Freight, due in 29 days',
      ]}
      today="Export the list, filter three columns, then open each PDF to find its notice period."
      with="She asks once. The list drops to three, and the earliest deadline is marked."
      steps={[2400, 2400, 2000, 1800, 1800, 5400]}
    >
      <Renewals />
    </SolScene>

    <SolScene
      n={2}
      kicker="Wednesday · the redline"
      title="Cedar sends back a redline. Find the edits that change the terms."
      said="What did Cedar change since our last draft?"
      beats={[
        'Compares Rachel’s draft with Cedar’s redline',
        'Sets aside 38 wording edits, still one tap away',
        'Marks the fee increase in 4.2',
        'Marks the renewal clause they added, 7.3',
        'Marks the liability cap in 9.1, beside the team’s playbook',
      ]}
      today="A compare report with 41 tracked changes, read line by line to find the few that change the deal."
      with="The fee, renewal and liability changes, marked in place, with the team’s playbook position beside the cap."
      steps={[2400, 2400, 2000, 1800, 1800, 2200, 6400]}
      flip
    >
      <Redline />
    </SolScene>

    <SolScene
      n={3}
      kicker="Friday · the signature"
      title="Marcus, the CFO, signs for the company and knows what page 4 says."
      said="What am I agreeing to on page 4?"
      beats={[
        'Hears “page 4”',
        'Turns to page 4 of 9',
        'Marks the fee and the term',
        'Marks what it takes to cancel',
      ]}
      today="Scroll to page 4, read it twice, email legal and wait for an answer."
      with="Page 4 opens with the fee, the term and the notice period marked. Marcus signs when he’s ready."
      steps={[2400, 2200, 1600, 1800, 1800, 6000]}
    >
      <Signing />
    </SolScene>
  </section>

  <Handoff />

  <SolFit
    lede="You keep the contract tool you have. Voqalize adds the voice in one of two ways."
    pnp="Add it to your client portal or signing page. The character reads your documents and help pages, then talks clients through an intake form, a contract or a signing page. The client signs."
    dev="Your contract AI keeps doing the reading, the search and the playbook checks. Voqalize gives it a voice and a character, plus the actions on screen: turning to a clause, marking it, comparing drafts."
  />

  <SolClose tagline="Stop making customers dig. Let them ask." cta="Give your app a voice in 5 minutes." current="solutions/legal" />
</SolutionLayout>
