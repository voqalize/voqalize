---
// Customer support. One customer, one conversation, on an example coffee subscription app:
// a question it answers, a change it makes, and a handoff to a person who already knows.
// Notes, copy and decisions: docs/sections/solutions-support.md.
import SolutionLayout from '../../components/solutions/SolutionLayout.astro';
import SolHero from '../../components/solutions/SolHero.astro';
import SolScene from '../../components/solutions/SolScene.astro';
import SolFit from '../../components/solutions/SolFit.astro';
import SolClose from '../../components/solutions/SolClose.astro';
import Desk from '../../components/solutions/support/Desk.astro';
import Order from '../../components/solutions/support/Order.astro';
import Plan from '../../components/solutions/support/Plan.astro';
import Billing from '../../components/solutions/support/Billing.astro';
import Handoff from '../../components/solutions/support/Handoff.astro';
import '../../styles/solutions/support.css';
---
<SolutionLayout
  id="support"
  title="Customer support"
  description="Voqalize for customer support: your customers ask out loud in your app. It answers, makes the change on screen, and hands off to your team with the whole story."
>
  <SolHero
    eyebrow="Customer support"
    title="Support that listens, then does the clicking."
    lede="Your customers ask out loud, right in your app. Your app answers, makes the change on the screen they're on, and brings in your team when a person should take over."
  >
    <Desk slot="stage" />
  </SolHero>

  <section class="sol-story" aria-labelledby="sp-story-t">
    <header class="s-head">
      <p class="eyebrow">One customer, one conversation</p>
      <h2 id="sp-story-t">Three things to sort out. She says each one once.</h2>
      <p class="s-lede">Dana orders coffee from Morning Roast, an example subscription app. Each scene picks up where the last one left off.</p>
    </header>

    <SolScene
      n={1} kicker="The question" title="A delivery that didn't show."
      said="Where's my order? It was supposed to come today."
      beats={['Hears the question', "Opens this week's order", "Reads the carrier's tracking", 'Marks the new delivery day', 'Tells her when']}
      today="Find the order page, copy a tracking number, paste it into the carrier's site, then email support anyway."
      with="She asks once. The app pulls up the order and the tracking and tells her Thursday."
      steps={[1400, 2600, 1300, 1700, 1300, 3600]}
    >
      <Order />
    </SolScene>

    <SolScene
      n={2} kicker="The change" title="Thursdays work better anyway." flip
      said="Then move me to Thursdays, and skip the next delivery."
      beats={['Hears two changes in one sentence', 'Switches the delivery day to Thursday', 'Skips the delivery on the 29th', 'Reads it back before saving', 'Saves when she says yes']}
      today="Plan, then Manage, then Delivery day, then a calendar on another page for the skip."
      with="She asks for both at once. It reads them back, and nothing is saved until she says yes."
      steps={[1300, 2600, 1500, 1400, 3000, 3000]}
    >
      <Plan />
    </SolScene>

    <SolScene
      n={3} kicker="The handoff" title="A person who already knows."
      said="And I think I was charged twice this month."
      beats={['Hears the problem', 'Finds both charges', "Says what it can't do, and who can", 'Hands Sam the notes', 'Sam picks up without asking her to repeat anything']}
      today="Press 2 for billing, hold music, then “what's your order number?” and the whole story again."
      with="Sam joins already holding the order, both charges and the Thursday change. Dana doesn't repeat herself."
      steps={[1300, 2400, 1600, 3800, 2000, 3600]}
    >
      <Billing />
    </SolScene>
  </section>

  <Handoff />

  <SolFit
    title="Start with the help center you already wrote."
    lede="Nobody rebuilds the app. Point it at your articles, or connect the tools your support team uses now."
    pnp="We read your help center and your site and run the agent for you, so it answers from your own articles and opens the right page while it talks. When a policy changes, you correct it in the console."
    dev="Connect your order, billing and ticketing systems. Your agent stays yours. It looks things up, changes plans when the customer says yes, and passes the conversation to your team."
  />

  <SolClose tagline="Answer the question before it becomes a ticket." cta="Paste your URL. Hear your site talk back." current="solutions/support" />
</SolutionLayout>
