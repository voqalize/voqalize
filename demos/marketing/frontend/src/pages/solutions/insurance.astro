---
// Insurance: one policyholder's fender-bender, start to finish. Hero: the "Step 1 of 6"
// auto quote filled from one sentence. Story: the accident (claim filled in by talking),
// the coverage question (read from her own policy), the follow-up (status and a body shop).
// Then the handoff to the adjuster, how it plugs in, and the close.
// Notes and decisions: docs/sections/solutions-insurance.md. Character: Tess.
import SolutionLayout from '../../components/solutions/SolutionLayout.astro';
import SolHero from '../../components/solutions/SolHero.astro';
import SolScene from '../../components/solutions/SolScene.astro';
import SolFit from '../../components/solutions/SolFit.astro';
import SolClose from '../../components/solutions/SolClose.astro';
import HeroQuote from '../../components/solutions/insurance/HeroQuote.astro';
import Accident from '../../components/solutions/insurance/Accident.astro';
import Coverage from '../../components/solutions/insurance/Coverage.astro';
import FollowUp from '../../components/solutions/insurance/FollowUp.astro';
import Handoff from '../../components/solutions/insurance/Handoff.astro';
import '../../styles/solutions/insurance.css';

const S1 = {
  said: "Someone just backed into me at the grocery store. Nobody's hurt, but my back bumper is smashed.",
  reply: 'Your claim is ready. Snap their plate and insurance card, then send it.',
};
const S2 = {
  said: "Am I covered for a rental car while mine's in the shop?",
  reply: 'Your policy lists $40 a day for up to 30 days. Priya, your adjuster, confirms it for this claim.',
};
const S3 = {
  said: "What's happening with my claim? And is there a body shop near work?",
  reply: 'Priya sends your estimate Thursday. Elm Street Collision is a mile from work. Want Friday at 8?',
};
---
<SolutionLayout id="insurance" title="Insurance" description="Let policyholders get a quote, report an accident and ask about their coverage by talking to the insurance app you already have. Your adjusters still decide every claim.">
  <SolHero
    eyebrow="Insurance"
    title="Your policyholders say what happened. Your app fills in the claim."
    lede="Keep the insurance app you have and let people talk to it. They get a quote, report an accident or check their coverage by saying it, on the screen they're already using. Your adjusters still decide every claim."
  >
    <HeroQuote slot="stage" reply="Your quote is $112 a month. Want to look it over first?" />
  </SolHero>

  <section class="sol-story" aria-labelledby="ins-story-t">
    <header class="s-head">
      <p class="eyebrow">One claim, three moments</p>
      <h2 id="ins-story-t">One fender-bender, start to finish.</h2>
      <p class="s-lede">Elena is an example policyholder in an example insurer's app, and every name and number here is made up. Three points in one claim, and each starts with something she says.</p>
    </header>

    <SolScene
      n={1} kicker="The accident" title="Reported from the parking lot, before she drives home."
      said={S1.said}
      beats={[
        'Elena says what happened, still in the parking lot.',
        "The app starts a claim draft with today's time and place.",
        'Her words fill in the report: parked, no injuries, rear bumper.',
        'It lists the photos her adjuster will need and waits for her to send.',
      ]}
      today="A dozen fields and a map pin, filled in while she's still rattled."
      with="She says it once. The claim is filled in and waiting for her to send before she leaves the lot."
      steps={[1400, 2400, 1400, 1400, 1500, 3800]}
    >
      <Accident {...S1} />
    </SolScene>

    <SolScene
      n={2} kicker="The question" title="Is a rental covered? The app reads her the policy." flip
      said={S2.said}
      beats={[
        'Elena asks about a rental car.',
        'The app opens her own policy.',
        'It finds the rental line and marks it.',
        'It notes her question on the claim for the adjuster.',
      ]}
      today="A policy PDF, or a call to the claims line."
      with="The app reads her the line from her own policy. The decision stays with her adjuster."
      steps={[1400, 2000, 1300, 1500, 1500, 4000]}
    >
      <Coverage {...S2} />
    </SolScene>

    <SolScene
      n={3} kicker="The follow-up" title="A week later: where is my claim, and who can fix the car?"
      said={S3.said}
      beats={[
        'Elena asks two things at once.',
        'The app shows where the claim stands, in plain steps.',
        'It lists body shops near her office.',
        'It finds a time for her to confirm.',
      ]}
      today="A status page that says “In review”, and a search for body shops."
      with="Plain status, a shop a mile from work, and a time she confirms."
      steps={[1400, 2300, 1500, 1500, 1400, 4000]}
    >
      <FollowUp {...S3} />
    </SolScene>
  </section>

  <Handoff />

  <SolFit
    pnp="Put a character on your quote, claims and help pages. It learns your coverage guides and works the forms you already have. Connect your policy and claims systems when you want it to answer for one policyholder."
    dev="Your agent keeps talking to your policy and claims systems, so your coverage rules stay where they are. Voqalize adds the voice and the character."
  />

  <SolClose tagline="Service you can talk to." cta="Give your app a voice in 5 minutes." current="solutions/insurance" />
</SolutionLayout>
