---
// Retail and e-commerce. One shopper's order, start to finish: the hero is her first
// sentence (find), the story is the rest (decide, buy, the exchange after the sale).
// Notes, copy and decisions: docs/sections/solutions-retail.md. Styles: src/styles/solutions/retail.css.
import SolutionLayout from '../../components/solutions/SolutionLayout.astro';
import SolHero from '../../components/solutions/SolHero.astro';
import SolScene from '../../components/solutions/SolScene.astro';
import SolFit from '../../components/solutions/SolFit.astro';
import SolClose from '../../components/solutions/SolClose.astro';
import HeroStore from '../../components/solutions/retail/HeroStore.astro';
import Compare from '../../components/solutions/retail/Compare.astro';
import Checkout from '../../components/solutions/retail/Checkout.astro';
import Exchange from '../../components/solutions/retail/Exchange.astro';
import Moments from '../../components/solutions/retail/Moments.astro';
import '../../styles/solutions/retail.css';
---
<SolutionLayout id="retail" title="Retail and e-commerce" description="Voqalize for online stores: shoppers say what they need, and your store searches, compares, fills the checkout and handles the exchange on screen while a character answers.">
  <SolHero
    eyebrow="Retail and e-commerce"
    title="Your customers shop in sentences. Let your store understand them."
    lede="Voqalize gives your store a voice and a character. Shoppers say what they need. The store finds it and fills in the checkout on screen while it answers."
  >
    <HeroStore slot="stage" />
  </SolHero>

  <section class="sol-story" aria-labelledby="rt-story-t">
    <header class="s-head">
      <p class="eyebrow">One order, start to finish</p>
      <h2 id="rt-story-t">The rest of Nora’s order took three more sentences.</h2>
      <p class="s-lede">One sentence got Nora three options in the store above. Here is how she picked one, paid, and swapped it two weeks later.</p>
      <p class="rt-note">Larkfield, Nora, her order and the prices are examples.</p>
    </header>

    <SolScene
      n={1} kicker="Decide" title="Compare on how he’ll use it."
      said="Which of the heated ones is better for him? He drives a truck all day."
      beats={[
        'Hears who it’s for and how he spends his day.',
        'Lines up the two heated picks.',
        'Fills in the rows that matter for him.',
        'Marks the row that decides it, the car plug.',
        'Answers, with the reason.',
      ]}
      today="Two tabs, two spec sheets, and a guess about which one has a car plug."
      with="The store puts the two side by side and says which one suits a man who drives all day."
      steps={[1800, 2600, 1900, 2000, 1900, 4600]}
    >
      <Compare />
    </SolScene>

    <SolScene
      n={2} kicker="Buy" title="A checkout that fills itself in." flip
      said="Ship it to my dad in Tucson, gift wrapped. Add a note: drive safe, Dad."
      beats={[
        'Hears the address, the wrapping and the note.',
        'Picks Dad’s saved address.',
        'Chooses the shipping that arrives before Sunday.',
        'Turns on gift wrap and writes the note.',
        'Leaves Place order to her.',
      ]}
      today="Twelve fields, a saved address behind a menu, and gift wrap on the last page."
      with="Every field comes from what she said or what the store already knows. She reads it over and places the order herself."
      steps={[1800, 2700, 1700, 1600, 1900, 1700, 4800]}
    >
      <Checkout />
    </SolScene>

    <SolScene
      n={3} kicker="After the sale" title="A swap instead of a refund."
      said="My brother got Dad the same cushion. Can I swap mine for the heated wrap?"
      beats={[
        'Hears which order and what to swap it for.',
        'Opens the order and sets the reason.',
        'Puts the wrap in the cushion’s place.',
        'Works out the $90 difference and the return label.',
        'Waits for her to confirm.',
      ]}
      today="Find the order number, pick a reason from a list, wait a week for the refund, then buy the wrap again."
      with="You keep the sale, and nothing is refunded until the shopper confirms."
      steps={[1800, 2700, 1700, 1600, 1900, 1600, 5000]}
    >
      <Exchange />
    </SolScene>
  </section>

  <Moments />

  <SolFit
    lede="You don’t rebuild the store. You choose how much of the setup your team builds itself."
    pnp="Paste your store’s URL to hear it, then add the script tag. Your character learns your product pages, size guides and return policy. Then it helps shoppers find things and check out on the pages you already have."
    dev="Your agent keeps its own line to the catalog, the cart and order history. Voqalize carries the conversation and sends its actions to the page, so the filters and the cart update on screen while it talks."
  />

  <SolClose tagline="Bring back the person behind the counter." cta="Paste your URL. Hear your site talk back." current="solutions/retail" />
</SolutionLayout>
