---
import Email from '../components/Email.astro';
// About: what Voqalize is and believes, then the people.
// Notes, copy options and decisions: docs/sections/page-about.md.
// Sections: hero (belief line + the "who did the talking" motion piece), five beliefs (a marker
// stroke draws under each in turn), the people (src/data/team.ts), story and contact
// links, the close. No careers page exists, so the close does not mention hiring.
import Page from '../layouts/Page.astro';
import Talk from '../components/pages/about/Talk.astro';
import People from '../components/pages/about/People.astro';
import { CONSOLE_URL } from '../data/env';
import '../styles/pages/about.css';

const beliefs = [
  { h: 'Voice is becoming the default way people use software.', mk: 'default',
    p: 'People already dictate messages and ask their phones things. The next step is software that answers, then does the task.' },
  { h: 'Most of a conversation is listening.', mk: 'listening',
    p: 'The hard part is hearing the whole thought, including the "actually" at the end, and knowing when to stay quiet.' },
  { h: 'Every app needs its own voice.', mk: 'own',
    p: 'Your app already knows the account, the screen and the last order. A voice that lives inside it can work out what the customer means.' },
  { h: 'A long conversation is easier with a face.', mk: 'face',
    p: 'People talk more easily when they can see they are being heard. So our characters show it when they listen and when they think.' },
  { h: "People shouldn't have to learn the menu.", mk: 'menu',
    p: 'For years we memorized where the button lives and what the setting is called. Software can do that work now and take the request as people say it.' },
];
// Wrap the marked word so a vermilion stroke can draw under it.
const split = (h: string, w: string) => { const i = h.indexOf(w); return [h.slice(0, i), w, h.slice(i + w.length)]; };
const markPath = 'M2 7 C 30 3, 60 9, 98 4';
---
<Page id="about" title="About" description="Voqalize is voice AI infrastructure, built in Bengaluru. What we believe about voice, and the people building it.">
  <p class="pg-crumb"><a href="/">Voqalize</a> / Company</p>

  <section class="ab-hero" aria-labelledby="ab-title" data-part="hero">
    <div class="ab-hero__text">
      <p class="eyebrow">About Voqalize</p>
      <h1 id="ab-title">Software should <span class="ab-mk">listen<svg viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d={markPath} /></svg></span> more than it talks.</h1>
      <p class="s-lede">Voqalize is voice AI infrastructure. We add voice to the apps, websites and AI agents companies already run, so their customers can say what they want and watch it happen on screen. We're based in Bengaluru, India.</p>
      <div class="ab-go">
        <a class="btn btn--ghost" href="#ab-people-t">Meet the team</a>
        <a class="btn btn--ghost" href="/story">Read our story</a>
      </div>
    </div>
    <div class="ab-hero__stage"><Talk /></div>
  </section>

  <section class="pg-block ab-beliefs" aria-labelledby="ab-beliefs-t" data-part="beliefs">
    <header class="s-head">
      <p class="eyebrow">What we believe</p>
      <h2 id="ab-beliefs-t">Five things we believe about voice.</h2>
    </header>
    <ol class="ab-bl" data-loop="400 900 900 900 900 120000">
      {beliefs.map((b, i) => {
        const [a, w, z] = split(b.h, b.mk);
        return (
          <li class={`ab-bl__i ab-bl${i + 1}`}>
            <span class="ab-bl__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{a}<span class="ab-mk">{w}<svg viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d={markPath} /></svg></span>{z}</h3>
              <p>{b.p}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <People />

  <section class="pg-block ab-next" aria-label="More about the company" data-part="more">
    <a class="ab-next__card" href="/story">
      <span class="eyebrow">Our story</span>
      <b>How Voqalize started, and where it's going.</b>
      <span class="ab-next__go">Read our story</span>
    </a>
    <a class="ab-next__card" href="/contact">
      <span class="eyebrow">Press and contact</span>
      <b>A question, a partnership or a press request.</b>
      <span class="ab-next__go">Get in touch</span>
    </a>
  </section>

  <section class="pg-block ab-close" aria-labelledby="ab-close-t" data-part="close">
    <h2 id="ab-close-t">Every app is about to get a voice. Make it yours.</h2>
    <p class="ab-close__cta">Try it on your own app today.</p>
    <div class="ab-go">
      <a class="btn btn--accent" href={CONSOLE_URL} data-console rel="noopener">Go to Console</a>
      <a class="btn btn--ghost" href="/experience" target="_blank" rel="noopener">Try a live demo</a>
    </div>
    <p class="ab-close__mail">Or write to us at <Email />.</p>
  </section>
</Page>
