---
// Press and contact. Founder (2026-10-12): no forms. Say "talk to us" and give the address,
// then the press kit. The head with the address (text and a Copy button, never a mailto link), press
// (#press, where /press redirects), and other ways in. Notes: docs/sections/page-contact.md.
// Styles: src/styles/pages/contact.css, all under .pg--contact.
import Page from '../layouts/Page.astro';
import Press from '../components/pages/contact/Press.astro';
import Ways from '../components/pages/contact/Ways.astro';
import { BOOK_URL, CONTACT_EMAIL } from '../data/contact';
import '../styles/pages/contact.css';
---
<Page id="contact" title="Press and contact" description="Write to the Voqalize team at support@voqalize.com, book a call with us, or find the logos, app icons and character images for a story.">
  <p class="pg-crumb"><a href="/">Voqalize</a> / Company</p>

  <div class="ct-hero" data-part="write">
    <header class="pg-head">
      <p class="eyebrow">Press and contact</p>
      <h1>Talk to us.</h1>
      <p class="s-lede">Sales, support, press, security or a partnership idea: it all goes to one inbox, and a person on the team reads every email.</p>
    </header>
    <div class="ct-mail" id="write">
      <p class="ct-mail__k">Write to us at</p>
      <p class="ct-mail__addr">{CONTACT_EMAIL}</p>
      <div class="ct-mail__go">
        <button class="btn" type="button" data-copy={CONTACT_EMAIL}>Copy address</button>
      </div>
      <p class="ct-mail__p">Writing a story? Put "Press" in the subject line. The press kit is <a href="#press">below</a>.</p>
    </div>
    <div class="ct-book" id="book">
      <p class="ct-mail__k">Rather talk it through?</p>
      <p class="ct-book__t">Book a call with Samkeet Jain, our co-founder. See a demo, or bring your app and your questions.</p>
      <div class="ct-mail__go">
        <a class="btn btn--accent" href={BOOK_URL} target="_blank" rel="noopener" data-book>Book a call</a>
      </div>
      <p class="ct-mail__p">Pick any free slot on the calendar. It opens in a new tab.</p>
    </div>
  </div>

  <Press />
  <Ways />
</Page>

<script>
  // Copy buttons (the address, the boilerplate paragraph).
  import '../scripts/copy';
</script>
