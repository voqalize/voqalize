---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Guide from '../components/Guide.astro';
import ReadHero from '../components/ReadHero.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
import Dock from '../components/Dock.astro';
import { SECTIONS } from '../data/sections';
---
<Base>
  <Header />
  <div class="app" id="app">
    <Guide />
    <main class="panel" id="panel">
      <ReadHero />
      {SECTIONS.map((def, i) => <Section def={def} n={i + 1} total={SECTIONS.length} />)}
      <!-- Talk mode only: another page of the site, shown beside Tanvi so the call carries on (open_page). -->
      <section class="sec sec--page" data-section="page" aria-label="Page"><iframe class="pageview" id="pageview" title="Page" loading="eager"></iframe></section>
    </main>
  </div>
  <Footer />
  <Dock />
  <script>import '../scripts/shell';</script>
</Base>
