# The explora agent's id and a publishable key for it whose allowed origins
# are https://www.explora.com, https://explora.com and
# https://reservations.explora.com: a page on any of them mints the session
# for a call. Neither is committed: this repo is public.
VOQALIZE_AGENT_ID=
VOQALIZE_PUBLISHABLE_KEY=
# The control plane the widget mints its session against. Dev by default.
VOQALIZE_API_BASE=https://app.dev.voqalize.com/api/v1
