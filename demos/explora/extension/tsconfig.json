{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["chrome", "node"],
    // `@voqalize/stage` is linked from the repo and only imports pipecat's
    // types: read them from this package's own copy, so there is one client type.
    "paths": { "@pipecat-ai/client-js": ["./node_modules/@pipecat-ai/client-js"] }
  },
  "include": ["src", "test", "playwright.config.ts"]
}
