# The site's own publishable key (its `site_live` key, from the Site Agent's
# console; the owner rotates it there). It is allowed on the site's origins
# only (for WOM: https://www.wom.cl), which is why content.js uses it from the
# page's own world. Never committed: this repo is public.
#
# One site: this file as .env beside build.mjs. Several sites: one
# sites/<id>/.env each (read first), so each build gets its own key.
VOQALIZE_PUBLISHABLE_KEY=
# The control plane: production, where the live Site Agents are.
VOQALIZE_API_BASE=https://app.voqalize.com/api/v1
# Optional, a cross-check only: the agent embed.config should serve. The agent,
# the site and the version always come from embed.config.
VOQALIZE_AGENT_ID=
