# Demo wiring for the frontend (Vite inlines VITE_* at build). Copy to `.env` and
# fill in per-environment values, or provision via the MCP `set_brain_url` flow.
#
# All demos share one tenant; each demo needs its agent id + publishable key.
VITE_DEMO_TENANT=demo

# travel — Travel Advisor
VITE_TRAVEL_AGENT=
VITE_TRAVEL_PK=

# shopping — Mobile Expert
VITE_SHOPPING_AGENT=
VITE_SHOPPING_PK=

# support — Returns Assistant
VITE_SUPPORT_AGENT=
VITE_SUPPORT_PK=

# servicing — Meridian Servicing Desk
VITE_SERVICING_AGENT=
VITE_SERVICING_PK=

# interview_bot — AI Interviewer
VITE_INTERVIEW_BOT_AGENT=
VITE_INTERVIEW_BOT_PK=

# sugar — Sugar Coach
VITE_SUGAR_AGENT=
VITE_SUGAR_PK=

# legal — Docket (Contract Review)
VITE_LEGAL_AGENT=
VITE_LEGAL_PK=

# lead_qual — Auric Gold Loan Advisor
VITE_LEAD_QUAL_AGENT=
VITE_LEAD_QUAL_PK=

# aura — Aura Bank Support
VITE_AURA_AGENT=
VITE_AURA_PK=
