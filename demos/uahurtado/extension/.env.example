# The uahurtado agent's id and a publishable key for it whose allowed origins
# are https://admision.uahurtado.cl, https://postgrados.uahurtado.cl and
# https://www.uahurtado.cl. Neither is committed: this repo is public.
VOQALIZE_AGENT_ID=
VOQALIZE_PUBLISHABLE_KEY=
# The control plane the widget mints its session against. Dev by default.
VOQALIZE_API_BASE=https://app.dev.voqalize.com/api/v1
# Whether the visitor's own press of the lead form's "Enviar" is stopped (1) or
# sent to the university (0). Unset: stopped in every build.
# UAHURTADO_BLOCK_SUBMIT=1
