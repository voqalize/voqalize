    "@voqalize/client-transport": "0.4.0",
    "@voqalize/demo-kit": "file:../../shared",
    "lucide-react": "^0.511.0",
    "marked": "^15.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
